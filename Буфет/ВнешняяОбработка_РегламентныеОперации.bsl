////////////////////////////////////////////////////////////////////////////////
// МОДУЛЬ ОБЪЕКТА ВНЕШНЕЙ ОБРАБОТКИ «РЕГЛАМЕНТНЫЕ ОПЕРАЦИИ БУФЕТА»
//
// Зачем: своё регламентное задание в расширение с режимом совместимости
// 8.3.14 добавить нельзя. Механизм дополнительных отчётов и обработок БСП
// позволяет обойтись без правки конфигурации: обработка регистрируется
// в справочнике и получает расписание штатными средствами.
//
// Команды:
//   * Пересчёт себестоимости по очереди — разгребает очередь, которую
//     наполняет запись цен на ингредиенты;
//   * Сверка себестоимости — сравнивает сохранённые значения с расчётными
//     и пишет расхождения в журнал регистрации, ничего не изменяя.
//
// Как подключить — раздел 4.3 документа ОНОВЛЕННЯ.md.
//
// ВАЖНО: обработка должна быть внешней (файл .epf), а не встроенной
// в конфигурацию. Регистрируется через «НСИ и администрирование» →
// «Печатные формы, отчёты и обработки» → «Дополнительные отчёты и обработки».
////////////////////////////////////////////////////////////////////////////////

#Область ПрограммныйИнтерфейс

// Сведения для механизма дополнительных отчётов и обработок БСП.
//
// Структура собирается вручную, а не через
// ДополнительныеОтчетыИОбработкиКлиентСервер.СведенияОВнешнейОбработке():
// так обработка подключается в более широком диапазоне версий БСП,
// не завися от наличия конкретной функции библиотеки.
//
// Возвращаемое значение:
//  Структура - параметры регистрации обработки
//
Функция СведенияОВнешнейОбработке() Экспорт

	ПараметрыРегистрации = Новый Структура;
	ПараметрыРегистрации.Вставить("Вид", "ДополнительнаяОбработка");
	ПараметрыРегистрации.Вставить("Наименование", "Регламентные операции Буфета");
	ПараметрыРегистрации.Вставить("Версия", "1.0");
	ПараметрыРегистрации.Вставить("ВерсияБСП", "2.1.3.11");
	ПараметрыРегистрации.Вставить("Назначение", Новый Массив);

	// Безопасный режим запрещает обращение к общим модулям расширения,
	// поэтому он должен быть выключен
	ПараметрыРегистрации.Вставить("БезопасныйРежим", Ложь);

	ПараметрыРегистрации.Вставить("Информация",
		"Пересчёт себестоимости техкарточек по очереди и сверка сохранённых
		|значений с расчётными. Обе команды предназначены для запуска
		|по расписанию.");

	ПараметрыРегистрации.Вставить("Команды", ТаблицаКоманд());

	Возврат ПараметрыРегистрации;

КонецФункции

// Точка входа механизма дополнительных обработок.
//
// Параметры:
//  ИдентификаторКоманды - Строка
//  ПараметрыВыполнения  - Структура
//
Процедура ВыполнитьКоманду(ИдентификаторКоманды, ПараметрыВыполнения) Экспорт

	Если ИдентификаторКоманды = "ПересчетСебестоимостиПоОчереди" Тогда
		ВыполнитьПересчетПоОчереди();

	ИначеЕсли ИдентификаторКоманды = "СверкаСебестоимости" Тогда
		ВыполнитьСверкуСебестоимости();

	Иначе
		ЗаписатьВЖурнал("Неизвестная команда: " + ИдентификаторКоманды,
			УровеньЖурналаРегистрации.Ошибка);
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Состав команд обработки в формате, который ожидает БСП.
Функция ТаблицаКоманд()

	Команды = Новый ТаблицаЗначений;
	Команды.Колонки.Добавить("Представление", Новый ОписаниеТипов("Строка"));
	Команды.Колонки.Добавить("Идентификатор", Новый ОписаниеТипов("Строка"));
	Команды.Колонки.Добавить("Использование", Новый ОписаниеТипов("Строка"));
	Команды.Колонки.Добавить("ПоказыватьОповещение", Новый ОписаниеТипов("Булево"));
	Команды.Колонки.Добавить("Модификатор", Новый ОписаниеТипов("Строка"));

	ДобавитьКоманду(Команды,
		"Пересчитать себестоимость по очереди",
		"ПересчетСебестоимостиПоОчереди");

	ДобавитьКоманду(Команды,
		"Сверить себестоимость техкарточек",
		"СверкаСебестоимости");

	Возврат Команды;

КонецФункции

Процедура ДобавитьКоманду(Команды, Представление, Идентификатор)

	Команда = Команды.Добавить();
	Команда.Представление = Представление;
	Команда.Идентификатор = Идентификатор;

	// ВызовСерверногоМетода — единственный вид команды, который можно
	// поставить на расписание: выполняется на сервере без участия клиента
	Команда.Использование = "ВызовСерверногоМетода";

	// При запуске по расписанию оповещать некого
	Команда.ПоказыватьОповещение = Ложь;

КонецПроцедуры

// Разгребает очередь пересчёта себестоимости.
Процедура ВыполнитьПересчетПоОчереди()

	Если Метаданные.РегистрыСведений.Найти("ОчередьПересчетаСебестоимости") = Неопределено Тогда
		ЗаписатьВЖурнал(
			"Регистр ОчередьПересчетаСебестоимости не создан — пересчёт пропущен",
			УровеньЖурналаРегистрации.Предупреждение);
		Возврат;
	КонецЕсли;

	НачалоВыполнения = ТекущаяДатаСеанса();

	Попытка
		РасчетСебестоимостиМодуль.ПересчитатьСебестоимостьПоОчереди();
	Исключение
		ЗаписатьВЖурнал("Ошибка пересчёта: " + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()),
			УровеньЖурналаРегистрации.Ошибка);
		ВызватьИсключение;
	КонецПопытки;

	ЗаписатьВЖурнал(СтрШаблон("Пересчёт по очереди завершён за %1 сек.",
		Формат(ТекущаяДатаСеанса() - НачалоВыполнения, "ЧДЦ=0; ЧГ=0")));

КонецПроцедуры

// Сверяет сохранённую себестоимость с расчётной.
Процедура ВыполнитьСверкуСебестоимости()

	Попытка
		Расхождений = РасчетСебестоимостиМодуль.СверитьСебестоимость();
	Исключение
		ЗаписатьВЖурнал("Ошибка сверки: " + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()),
			УровеньЖурналаРегистрации.Ошибка);
		ВызватьИсключение;
	КонецПопытки;

	Если Расхождений = 0 Тогда
		ЗаписатьВЖурнал("Сверка себестоимости: расхождений нет");
	Иначе
		ЗаписатьВЖурнал(СтрШаблон(
			"Сверка себестоимости: расхождений — %1. Подробности в событии «Сверка себестоимости»",
			Формат(Расхождений, "ЧДЦ=0; ЧГ=0")),
			УровеньЖурналаРегистрации.Предупреждение);
	КонецЕсли;

КонецПроцедуры

Процедура ЗаписатьВЖурнал(Текст, Уровень = Неопределено)

	ЗаписьЖурналаРегистрации("Регламентные операции Буфета",
		?(Уровень = Неопределено, УровеньЖурналаРегистрации.Информация, Уровень),
		, , Текст);

КонецПроцедуры

#КонецОбласти

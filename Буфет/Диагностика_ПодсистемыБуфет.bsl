////////////////////////////////////////////////////////////////////////////////
// ДИАГНОСТИКА ПОДСИСТЕМЫ «БУФЕТ»
//
// Внешняя обработка: проверяет, что расширение развёрнуто полностью
// и расчёт себестоимости работает от цены до аналитики.
//
// Модуль объекта внешней обработки — директивы компиляции не указываются.
// Запуск: открыть обработку и вызвать ВыполнитьДиагностику().
//
// Ничего не записывает в базу: только читает метаданные и данные.
//
// Прежняя версия этого файла создавала тестовый рецепт и проверяла списание
// по РегистрНакопления.СписаниеПоРецептам. Ни этого регистра, ни табличной
// части состава у рецепта в расширении нет — тот код был неработоспособен.
////////////////////////////////////////////////////////////////////////////////

#Область ПрограммныйИнтерфейс

// Полная проверка развёртывания подсистемы.
//
// Возвращаемое значение:
//  Булево - Истина, если критичных проблем не обнаружено
//
Функция ВыполнитьДиагностику() Экспорт

	Проблемы = Новый Массив;

	Сообщить("=== ДИАГНОСТИКА ПОДСИСТЕМЫ «БУФЕТ» ===");

	ПроверитьМетаданные(Проблемы);
	ПроверитьЦены(Проблемы);
	ПроверитьТехкарточки(Проблемы);
	ПроверитьАналитику(Проблемы);

	Сообщить("");
	Если Проблемы.Количество() = 0 Тогда
		Сообщить("ИТОГ: проблем не обнаружено");
		Возврат Истина;
	КонецЕсли;

	Сообщить("ИТОГ: обнаружено проблем — " + Формат(Проблемы.Количество(), "ЧДЦ=0; ЧГ=0"));
	Для Каждого Проблема Из Проблемы Цикл
		Сообщить("  • " + Проблема);
	КонецЦикла;

	Возврат Ложь;

КонецФункции

// Показывает, как система видит единицы измерения ингредиентов блюда.
//
// Отвечает на вопрос «почему списывается 360 булок вместо 6»: печатает
// норму из техкарточки, найденный вес единицы и итоговое количество,
// которое попадёт в движения.
//
// Параметры:
//  НаименованиеБлюда - Строка - часть наименования готового блюда.
//                      Пусто — разбирается несколько первых техкарточек.
//
// Реквизит формы намеренно строковый, а не ссылка на техкарточку:
// справочник Техкарточки живёт в расширении, и типа
// СправочникСсылка.Техкарточки нет в списке типов при создании реквизита
// ВНЕШНЕЙ обработки. В запросах обращаться к нему можно — там имя
// разрешается во время выполнения, когда расширение уже подключено.
//
Процедура ПроверитьЕдиницыИзмерения(НаименованиеБлюда = "") Экспорт

	Сообщить("=== ЕДИНИЦЫ ИЗМЕРЕНИЯ ИНГРЕДИЕНТОВ ===");
	Сообщить("");

	// Сначала выясняем, какие реквизиты веса вообще есть у номенклатуры
	Сообщить("--- Реквизиты номенклатуры, похожие на вес ---");
	НайденоРеквизитов = 0;
	Для Каждого Реквизит Из Метаданные.Справочники.Номенклатура.Реквизиты Цикл
		Если Найти(ВРег(Реквизит.Имя), "ВЕС") = 1 Тогда
			Сообщить("  " + Реквизит.Имя + " — " + Строка(Реквизит.Тип));
			НайденоРеквизитов = НайденоРеквизитов + 1;
		КонецЕсли;
	КонецЦикла;

	Если НайденоРеквизитов = 0 Тогда
		Сообщить("  НЕ НАЙДЕНО. Вес хранится где-то ещё — сообщите об этом,");
		Сообщить("  расчёт нужно будет привязать к другому реквизиту.");
	КонецЕсли;

	Сообщить("");
	Сообщить("Расчёт читает вес выражением:");
	Сообщить("  " + РасчетСебестоимостиМодуль.ВыражениеВесаЕдиницы("Номенклатура"));

	Сообщить("");
	Если ПустаяСтрока(НаименованиеБлюда) Тогда
		Сообщить("Отбор не задан.");
	Иначе
		Сообщить("Отбор по наименованию: «" + СокрЛП(НаименованиеБлюда) + "»");
	КонецЕсли;

	// Без отбора разбираем несколько первых техкарточек: так обработка
	// полезна сразу после открытия, ничего вводить не нужно
	КоличествоРазбираемых = ?(ПустаяСтрока(НаименованиеБлюда), 3, 10);

	Запрос = Новый Запрос(
		"ВЫБРАТЬ ПЕРВЫЕ " + Формат(КоличествоРазбираемых, "ЧДЦ=0; ЧГ=0") + "
		|	Техкарточки.ГотовоеБлюдо КАК ГотовоеБлюдо
		|ИЗ
		|	Справочник.Техкарточки КАК Техкарточки
		|ГДЕ
		|	Техкарточки.ГотовоеБлюдо <> ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка)
		|	И НЕ Техкарточки.ПометкаУдаления
		|	И Техкарточки.ГотовоеБлюдо.Наименование ПОДОБНО &Наименование
		|УПОРЯДОЧИТЬ ПО
		|	Техкарточки.ГотовоеБлюдо.Наименование");
	Запрос.УстановитьПараметр("Наименование", "%" + СокрЛП(НаименованиеБлюда) + "%");

	ВыборкаКарточек = Запрос.Выполнить().Выбрать();

	Если НЕ ВыборкаКарточек.Следующий() Тогда
		Сообщить("");
		Если ПустаяСтрока(НаименованиеБлюда) Тогда
			Сообщить("Техкарточек не найдено");
		Иначе
			Сообщить("Техкарточка с таким наименованием не найдена.");
			ВывестиСписокТехкарточек();
		КонецЕсли;
		Возврат;
	КонецЕсли;

	Если ПустаяСтрока(НаименованиеБлюда) Тогда
		Сообщить("");
		Сообщить("Разбираются первые " + Формат(КоличествоРазбираемых, "ЧДЦ=0; ЧГ=0")
			+ " техкарточки. Чтобы посмотреть конкретную, впишите часть её наименования.");
	КонецЕсли;

	ВыборкаКарточек.Сбросить();

	Пока ВыборкаКарточек.Следующий() Цикл
		РазобратьСоставБлюда(ВыборкаКарточек.ГотовоеБлюдо);
	КонецЦикла;

КонецПроцедуры

// Снимает контрольные показатели базы — для сверки до и после обновления.
//
// Запустите до внесения изменений, сохраните вывод, повторите после
// обновления конфигурации. Количества измениться не должны: если что-то
// уменьшилось — данные потеряны при реструктуризации.
//
// Возвращаемое значение:
//  Структура - снятые показатели
//
Функция СнятьКонтрольныеПоказатели() Экспорт

	Показатели = Новый Структура;
	Показатели.Вставить("Техкарточек", 0);
	Показатели.Вставить("СуммаСебестоимости", 0);
	Показатели.Вставить("СтрокСостава", 0);
	Показатели.Вставить("Рецептов", 0);
	Показатели.Вставить("Цен", 0);
	Показатели.Вставить("ДокументовПроведено", 0);
	Показатели.Вставить("ЗаписейАналитики", 0);

	Запрос = Новый Запрос(
		"ВЫБРАТЬ
		|	КОЛИЧЕСТВО(*) КАК Значение
		|ИЗ
		|	Справочник.Техкарточки КАК Т
		|ГДЕ
		|	НЕ Т.ПометкаУдаления
		|;
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ЕСТЬNULL(СУММА(Т.СебестоимостьПорции), 0) КАК Значение
		|ИЗ
		|	Справочник.Техкарточки КАК Т
		|ГДЕ
		|	НЕ Т.ПометкаУдаления
		|;
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	КОЛИЧЕСТВО(*) КАК Значение
		|ИЗ
		|	Справочник.Техкарточки.СоставИнгредиентов КАК С
		|;
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	КОЛИЧЕСТВО(*) КАК Значение
		|ИЗ
		|	Справочник.КулинарныеРецепты КАК Р
		|ГДЕ
		|	НЕ Р.ПометкаУдаления
		|;
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	КОЛИЧЕСТВО(*) КАК Значение
		|ИЗ
		|	Справочник.ЦеныНаИнгредиенты КАК Ц
		|ГДЕ
		|	НЕ Ц.ПометкаУдаления
		|;
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	КОЛИЧЕСТВО(*) КАК Значение
		|ИЗ
		|	Документ.ПриготовлениеБлюда КАК Д
		|ГДЕ
		|	Д.Проведен
		|;
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	КОЛИЧЕСТВО(*) КАК Значение
		|ИЗ
		|	РегистрСведений.ПриготовлениеПоРецептам КАК А");

	Пакет = Запрос.ВыполнитьПакет();

	ИменаПоказателей = Новый Массив;
	ИменаПоказателей.Добавить("Техкарточек");
	ИменаПоказателей.Добавить("СуммаСебестоимости");
	ИменаПоказателей.Добавить("СтрокСостава");
	ИменаПоказателей.Добавить("Рецептов");
	ИменаПоказателей.Добавить("Цен");
	ИменаПоказателей.Добавить("ДокументовПроведено");
	ИменаПоказателей.Добавить("ЗаписейАналитики");

	Сообщить("=== КОНТРОЛЬНЫЕ ПОКАЗАТЕЛИ ===");

	Индекс = 0;
	Для Каждого ИмяПоказателя Из ИменаПоказателей Цикл

		Выборка = Пакет[Индекс].Выбрать();
		Выборка.Следующий();
		Показатели[ИмяПоказателя] = Выборка.Значение;

		Сообщить("  " + ИмяПоказателя + ": " + Формат(Выборка.Значение, "ЧДЦ=2; ЧГ=0"));

		Индекс = Индекс + 1;

	КонецЦикла;

	Возврат Показатели;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Печатает разбор состава одного блюда: что дошло до расчёта количества.
Процедура РазобратьСоставБлюда(ГотовоеБлюдо)

	Сообщить("");
	Сообщить("--- " + Строка(ГотовоеБлюдо) + " ---");

	Выборка = РасчетСебестоимостиМодуль.ВыбратьСоставТехкарточки(ГотовоеБлюдо);

	Если Выборка = Неопределено Тогда
		Сообщить("  Не удалось прочитать состав");
		Возврат;
	КонецЕсли;

	ЕстьСтроки = Ложь;

	Пока Выборка.Следующий() Цикл

		ЕстьСтроки = Истина;

		Количество = РасчетСебестоимостиМодуль.ПривестиНормуПоДаннымЕдиницы(
			Выборка.НормаБрутто, Выборка.ВесЕдиницы, Выборка.ИмяЕдиницы, Выборка.ЕдиницаНормы);

		Сообщить(СтрШаблон("  %1", Выборка.Ингредиент));
		Сообщить(СтрШаблон("      норма %1 | единица «%2» | вес единицы %3 | на порцию %4",
			Формат(Выборка.НормаБрутто, "ЧДЦ=3"),
			?(ПустаяСтрока(Выборка.ИмяЕдиницы), "не определена", Выборка.ИмяЕдиницы),
			?(ЗначениеЗаполнено(Выборка.ВесЕдиницы), Формат(Выборка.ВесЕдиницы, "ЧДЦ=3") + " кг", "НЕ ЗАПОЛНЕН"),
			Формат(Количество, "ЧДЦ=3")));

		Сообщить("      реквизиты веса: " + ОписаниеВесаНоменклатуры(Выборка.Ингредиент));

		Если НЕ ЗначениеЗаполнено(Выборка.ВесЕдиницы) И ШтучнаяЕдиница(Выборка.ИмяЕдиницы) Тогда
			Сообщить("      ВНИМАНИЕ: учёт в штуках без веса — норма трактуется как количество штук");
		КонецЕсли;

	КонецЦикла;

	Если НЕ ЕстьСтроки Тогда
		Сообщить("  Состав пуст либо все нормы нулевые");
	КонецЕсли;

КонецПроцедуры

// Печатает фактические значения реквизитов веса номенклатуры.
// Именно здесь видно, пуст ли вес у конкретного ингредиента
// или расчёт читает его не из того места.
Функция ОписаниеВесаНоменклатуры(Номенклатура)

	Имена = Новый Массив;
	Для Каждого Реквизит Из Метаданные.Справочники.Номенклатура.Реквизиты Цикл
		Если Найти(ВРег(Реквизит.Имя), "ВЕС") = 1 Тогда
			Имена.Добавить(Реквизит.Имя);
		КонецЕсли;
	КонецЦикла;

	Если Имена.Количество() = 0 Тогда
		Возврат "реквизитов веса в номенклатуре нет";
	КонецЕсли;

	Значения = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Номенклатура, СтрСоединить(Имена, ","));

	Части = Новый Массив;
	Для Каждого КлючЗначение Из Значения Цикл
		Части.Добавить(КлючЗначение.Ключ + " = " + Строка(КлючЗначение.Значение));
	КонецЦикла;

	// Вес задан в единицах ВесЕдиницаИзмерения. Если это не та единица,
	// в которой ведётся учёт остатков, пересчёт нормы будет неверным —
	// такое надо увидеть сразу.
	Если Значения.Свойство("ВесЕдиницаИзмерения") И ЗначениеЗаполнено(Значения.ВесЕдиницаИзмерения) Тогда

		ЕдиницаХранения = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Номенклатура, "ЕдиницаИзмерения");

		Если ЗначениеЗаполнено(ЕдиницаХранения) И ЕдиницаХранения <> Значения.ВесЕдиницаИзмерения Тогда
			Части.Добавить(СтрШаблон("ВНИМАНИЕ: вес задан в «%1», а учёт в «%2»",
				Значения.ВесЕдиницаИзмерения, ЕдиницаХранения));
		КонецЕсли;

	КонецЕсли;

	Возврат СтрСоединить(Части, "; ");

КонецФункции

Функция ШтучнаяЕдиница(ИмяЕдиницы)

	Единица = ВРег(СокрЛП(?(ИмяЕдиницы = Неопределено, "", ИмяЕдиницы)));

	Возврат Единица = "ШТ" ИЛИ Единица = "ШТ." ИЛИ Единица = "ШТУКА" ИЛИ Единица = "УП";

КонецФункции

// Печатает список техкарточек — чтобы было откуда взять наименование.
Процедура ВывестиСписокТехкарточек()

	Запрос = Новый Запрос(
		"ВЫБРАТЬ ПЕРВЫЕ 30
		|	Техкарточки.ГотовоеБлюдо.Наименование КАК Наименование
		|ИЗ
		|	Справочник.Техкарточки КАК Техкарточки
		|ГДЕ
		|	НЕ Техкарточки.ПометкаУдаления
		|	И Техкарточки.ГотовоеБлюдо <> ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка)
		|УПОРЯДОЧИТЬ ПО
		|	Наименование");

	Выборка = Запрос.Выполнить().Выбрать();

	Сообщить("");
	Сообщить("Доступные блюда (первые 30):");
	Пока Выборка.Следующий() Цикл
		Сообщить("  • " + Выборка.Наименование);
	КонецЦикла;

КонецПроцедуры

// Проверяет, что все объекты подсистемы существуют в конфигурации.
Процедура ПроверитьМетаданные(Проблемы)

	Сообщить("");
	Сообщить("--- Объекты метаданных ---");

	ПроверитьНаличиеОбъекта("Справочники", "Техкарточки", Проблемы);
	ПроверитьНаличиеОбъекта("Справочники", "КулинарныеРецепты", Проблемы);
	ПроверитьНаличиеОбъекта("Справочники", "ЦеныНаИнгредиенты", Проблемы);
	ПроверитьНаличиеОбъекта("Справочники", "ПищеваяЦенностьИнгредиентов", Проблемы);
	ПроверитьНаличиеОбъекта("Документы", "ПриготовлениеБлюда", Проблемы);
	ПроверитьНаличиеОбъекта("РегистрыСведений", "ПриготовлениеПоРецептам", Проблемы);
	ПроверитьНаличиеОбъекта("Перечисления", "КатегорииБлюд", Проблемы);
	ПроверитьНаличиеОбъекта("Перечисления", "РежимыОбновленияЦен", Проблемы);
	ПроверитьНаличиеОбъекта("Обработки", "ОбновлениеЦенВТехКарточках", Проблемы);

	// Ключевой реквизит: без него состав блюда взять неоткуда
	Если Метаданные.Справочники.Найти("КулинарныеРецепты") <> Неопределено
		И Метаданные.Справочники.КулинарныеРецепты.Реквизиты.Найти("Техкарточка") = Неопределено Тогда
		Сообщить("  ОШИБКА: у справочника КулинарныеРецепты нет реквизита Техкарточка");
		Проблемы.Добавить("КулинарныеРецепты.Техкарточка отсутствует");
	КонецЕсли;

	Если Метаданные.Обработки.Найти("ОбновлениеЦенВТехКарточках") <> Неопределено
		И Метаданные.Обработки.ОбновлениеЦенВТехКарточках.Реквизиты.Найти("ВыбраннаяКатегория") = Неопределено Тогда
		Сообщить("  ПРЕДУПРЕЖДЕНИЕ: нет реквизита ВыбраннаяКатегория — режим «По категории» недоступен");
	КонецЕсли;

	// Режим записи регистра определяет способ записи аналитики из документа
	Если Метаданные.РегистрыСведений.Найти("ПриготовлениеПоРецептам") <> Неопределено Тогда
		Подчинен = Метаданные.РегистрыСведений.ПриготовлениеПоРецептам.РежимЗаписи
			= Метаданные.СвойстваОбъектов.РежимЗаписиРегистра.ПодчинениеРегистратору;
		Если Подчинен Тогда
			Сообщить("  ПриготовлениеПоРецептам: подчинён регистратору");
		Иначе
			Сообщить("  ПриготовлениеПоРецептам: независимый (записи привязаны к дате документа)");
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры

Процедура ПроверитьНаличиеОбъекта(ВидОбъекта, ИмяОбъекта, Проблемы)

	Коллекция = Метаданные[ВидОбъекта];

	Если Коллекция.Найти(ИмяОбъекта) = Неопределено Тогда
		Сообщить("  НЕТ: " + ВидОбъекта + "." + ИмяОбъекта);
		Проблемы.Добавить("Отсутствует " + ВидОбъекта + "." + ИмяОбъекта);
	Иначе
		Сообщить("  есть: " + ВидОбъекта + "." + ИмяОбъекта);
	КонецЕсли;

КонецПроцедуры

// Проверяет заполненность цен на ингредиенты.
Процедура ПроверитьЦены(Проблемы)

	Сообщить("");
	Сообщить("--- Цены на ингредиенты ---");

	Если Метаданные.Справочники.Найти("ЦеныНаИнгредиенты") = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Запрос = Новый Запрос(
		"ВЫБРАТЬ
		|	КОЛИЧЕСТВО(*) КАК Всего,
		|	СУММА(ВЫБОР КОГДА Цены.Активность ТОГДА 1 ИНАЧЕ 0 КОНЕЦ) КАК Активных,
		|	СУММА(ВЫБОР КОГДА Цены.ЦенаЗаЕдиницу > 0 ТОГДА 1 ИНАЧЕ 0 КОНЕЦ) КАК СЦеной,
		|	СУММА(ВЫБОР КОГДА Цены.ЕдиницаИзмерения = ЗНАЧЕНИЕ(Справочник.УпаковкиЕдиницыИзмерения.ПустаяСсылка)
		|		ТОГДА 1 ИНАЧЕ 0 КОНЕЦ) КАК БезЕдиницы
		|ИЗ
		|	Справочник.ЦеныНаИнгредиенты КАК Цены
		|ГДЕ
		|	НЕ Цены.ПометкаУдаления");

	Выборка = Запрос.Выполнить().Выбрать();
	Выборка.Следующий();

	Сообщить("  всего записей: " + Формат(Выборка.Всего, "ЧДЦ=0; ЧГ=0"));
	Сообщить("  активных: " + Формат(Выборка.Активных, "ЧДЦ=0; ЧГ=0"));
	Сообщить("  с заполненной ценой: " + Формат(Выборка.СЦеной, "ЧДЦ=0; ЧГ=0"));

	Если Выборка.Всего = 0 Тогда
		Проблемы.Добавить("Справочник ЦеныНаИнгредиенты пуст — себестоимость будет нулевой");
	ИначеЕсли Выборка.Активных = 0 Тогда
		Проблемы.Добавить("Нет ни одной активной цены — установите признак Активность");
	КонецЕсли;

	Если Выборка.БезЕдиницы > 0 Тогда
		Сообщить("  ПРЕДУПРЕЖДЕНИЕ: без единицы измерения — "
			+ Формат(Выборка.БезЕдиницы, "ЧДЦ=0; ЧГ=0") + " (цена считается за килограмм)");
	КонецЕсли;

КонецПроцедуры

// Сверяет сохранённую себестоимость с рассчитанной заново.
Процедура ПроверитьТехкарточки(Проблемы)

	Сообщить("");
	Сообщить("--- Технологические карты ---");

	Если Метаданные.Справочники.Найти("Техкарточки") = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Запрос = Новый Запрос(
		"ВЫБРАТЬ
		|	Техкарточки.Ссылка КАК Ссылка,
		|	Техкарточки.СебестоимостьПорции КАК СебестоимостьПорции,
		|	КОЛИЧЕСТВО(Состав.Ингредиент) КАК СтрокСостава
		|ИЗ
		|	Справочник.Техкарточки КАК Техкарточки
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Техкарточки.СоставИнгредиентов КАК Состав
		|		ПО Техкарточки.Ссылка = Состав.Ссылка
		|ГДЕ
		|	НЕ Техкарточки.ПометкаУдаления
		|СГРУППИРОВАТЬ ПО
		|	Техкарточки.Ссылка,
		|	Техкарточки.СебестоимостьПорции");

	Выборка = Запрос.Выполнить().Выбрать();

	Всего = 0;
	БезСостава = 0;
	БезСебестоимости = 0;
	Расхождения = 0;

	Пока Выборка.Следующий() Цикл

		Всего = Всего + 1;

		Если Выборка.СтрокСостава = 0 Тогда
			БезСостава = БезСостава + 1;
			Продолжить;
		КонецЕсли;

		Если Выборка.СебестоимостьПорции = 0 Тогда
			БезСебестоимости = БезСебестоимости + 1;
		КонецЕсли;

		// Пересчитываем независимо и сравниваем с сохранённым значением
		Расчетная = РасчетСебестоимостиМодуль.РассчитатьСебестоимостьТехКарточки(Выборка.Ссылка);

		Если Окр(Расчетная, 2) <> Окр(Выборка.СебестоимостьПорции, 2) Тогда
			Расхождения = Расхождения + 1;
			Если Расхождения <= 5 Тогда
				Сообщить("  расхождение: " + Строка(Выборка.Ссылка)
					+ " — сохранено " + Формат(Выборка.СебестоимостьПорции, "ЧДЦ=2")
					+ ", рассчитано " + Формат(Расчетная, "ЧДЦ=2"));
			КонецЕсли;
		КонецЕсли;

	КонецЦикла;

	Сообщить("  всего техкарточек: " + Формат(Всего, "ЧДЦ=0; ЧГ=0"));
	Сообщить("  без состава: " + Формат(БезСостава, "ЧДЦ=0; ЧГ=0"));
	Сообщить("  с нулевой себестоимостью: " + Формат(БезСебестоимости, "ЧДЦ=0; ЧГ=0"));
	Сообщить("  расхождений расчёта: " + Формат(Расхождения, "ЧДЦ=0; ЧГ=0"));

	Если Всего = 0 Тогда
		Проблемы.Добавить("Нет ни одной техкарточки");
	КонецЕсли;

	Если Расхождения > 0 Тогда
		Проблемы.Добавить("Сохранённая себестоимость расходится с расчётной ("
			+ Формат(Расхождения, "ЧДЦ=0; ЧГ=0") + " шт.) — запустите обработку обновления цен");
	КонецЕсли;

КонецПроцедуры

// Проверяет, что проведённые документы пишут аналитику приготовления.
Процедура ПроверитьАналитику(Проблемы)

	Сообщить("");
	Сообщить("--- Аналитика приготовления ---");

	Если Метаданные.Документы.Найти("ПриготовлениеБлюда") = Неопределено
		Или Метаданные.РегистрыСведений.Найти("ПриготовлениеПоРецептам") = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Запрос = Новый Запрос(
		"ВЫБРАТЬ
		|	КОЛИЧЕСТВО(*) КАК Проведенных
		|ИЗ
		|	Документ.ПриготовлениеБлюда КАК Документы
		|ГДЕ
		|	Документы.Проведен
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	КОЛИЧЕСТВО(*) КАК Записей
		|ИЗ
		|	РегистрСведений.ПриготовлениеПоРецептам КАК Аналитика");

	Пакет = Запрос.ВыполнитьПакет();

	ВыборкаДокументов = Пакет[0].Выбрать();
	ВыборкаДокументов.Следующий();

	ВыборкаЗаписей = Пакет[1].Выбрать();
	ВыборкаЗаписей.Следующий();

	Сообщить("  проведённых документов: " + Формат(ВыборкаДокументов.Проведенных, "ЧДЦ=0; ЧГ=0"));
	Сообщить("  записей аналитики: " + Формат(ВыборкаЗаписей.Записей, "ЧДЦ=0; ЧГ=0"));

	Если ВыборкаДокументов.Проведенных > 0 И ВыборкаЗаписей.Записей = 0 Тогда
		Проблемы.Добавить("Документы проведены, но регистр ПриготовлениеПоРецептам пуст —"
			+ " модуль объекта документа не пишет аналитику, отчёты будут нулевыми");
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

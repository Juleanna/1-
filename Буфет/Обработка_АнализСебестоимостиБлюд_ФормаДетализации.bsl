////////////////////////////////////////////////////////////////////////////////
// МОДУЛЬ ФОРМЫ «ДЕТАЛИЗАЦИЯ ПО ИНГРЕДИЕНТАМ»
// Обработка.АнализСебестоимостиБлюд
//
// Форма открывается из отчёта «Анализ себестоимости с диаграммой» двойным
// щелчком по строке результата:
//   ОткрытьФорму("Обработка.АнализСебестоимостиБлюд.Форма.ДетализацияПоИнгредиентам", ...)
//
// Без этой формы двойной щелчок выдаёт ошибку «Форма не найдена»,
// поэтому она обязательна, если отчёт создаётся.
//
// ВАЖНО, где именно создавать форму: у ОБРАБОТКИ «АнализСебестоимостиБлюд»,
// а не у отчёта. Путь в ОткрытьФорму начинается с «Обработка.», и если форма
// заведена у отчёта, платформа её не найдёт.
//
// Имя формы должно быть ровно ДетализацияПоИнгредиентам.
//
// Что должно быть на форме:
//   * параметры  Рецепт, НачалоПериода, КонецПериода, Склад
//   * реквизит   Детализация — ТаблицаЗначений с колонками
//                Ингредиент, КоличествоИспользовано,
//                СтоимостьИспользовано, СредняяЦенаЗаПериод
//   * таблица    Детализация в дереве элементов
//
// Привязка: форма → событие ПриСозданииНаСервере → ПриСозданииНаСервере.
//
// Порядок создания — пункт 4.7 инструкции ОНОВЛЕННЯ.md.
////////////////////////////////////////////////////////////////////////////////

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	Если НЕ ЗначениеЗаполнено(Параметры.Рецепт) Тогда
		Отказ = Истина;
		Возврат;
	КонецЕсли;

	ТаблицаДетализации = РеквизитФормыПоИмени("Детализация");

	Если ТаблицаДетализации = Неопределено Тогда
		ОбщегоНазначения.СообщитьПользователю(
			"На форме не создан реквизит «Детализация» — расшифровку выводить некуда."
			+ " Порядок создания: пункт 4.7 инструкции ОНОВЛЕННЯ.md");
		Возврат;
	КонецЕсли;

	// Обработка создаётся напрямую, а не берётся из реквизита «Объект»:
	// форме детализации сам объект обработки не нужен, ей нужны только данные
	ОбработкаАнализ = Обработки.АнализСебестоимостиБлюд.Создать();

	Данные = ОбработкаАнализ.ПолучитьДетализациюПоИнгредиентам(
		Параметры.Рецепт,
		Параметры.НачалоПериода,
		Параметры.КонецПериода,
		Параметры.Склад);

	ТаблицаДетализации.Загрузить(Данные);

	Заголовок = СтрШаблон("Ингредиенты: %1 (%2 — %3)",
		Параметры.Рецепт,
		Формат(Параметры.НачалоПериода, "ДФ=dd.MM.yyyy"),
		Формат(Параметры.КонецПериода, "ДФ=dd.MM.yyyy"));

	ЗаполнитьИтоги(ТаблицаДетализации);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Реквизиты формы читаются по имени, а не напрямую.
//
// Индексный доступ не проверяется при компиляции, поэтому модуль можно
// вставить в форму до того, как реквизиты созданы: вместо «Переменная
// не определена» будет понятное сообщение при открытии формы.
&НаСервере
Функция РеквизитФормыПоИмени(ИмяРеквизита)

	Попытка
		Возврат ЭтотОбъект[ИмяРеквизита];
	Исключение
		Возврат Неопределено;
	КонецПопытки;

КонецФункции

// Итог выводится в подвал формы: без него приходится складывать колонку глазами.
&НаСервере
Процедура ЗаполнитьИтоги(ТаблицаДетализации)

	// Реквизит необязателен: пока его нет на форме, итог просто не показывается
	Если РеквизитФормыПоИмени("ИтогоСтоимость") = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Итог = 0;

	Для Каждого СтрокаДетализации Из ТаблицаДетализации Цикл
		Итог = Итог + СтрокаДетализации.СтоимостьИспользовано;
	КонецЦикла;

	ЭтотОбъект["ИтогоСтоимость"] = Итог;

КонецПроцедуры

#КонецОбласти

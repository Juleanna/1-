// Модуль объекта документа "Приготовление блюда"

#Область ОписаниеПеременных

// Состав ингредиентов по блюдам документа: ключ — блюдо, значение — таблица
// с колонками Ингредиент и ОбщееКоличество.
//
// Кэш нужен, потому что за одно проведение состав требуется трижды: для
// движений по складам, для аналитики и для контроля остатков. Без него
// один и тот же запрос выполнялся бы по три раза на каждое блюдо.
Перем КэшСостава;

#КонецОбласти

#Область ОбработчикиСобытий

// Вызывается при проверке заполнения перед записью.
//
// Проверки живут в модуле объекта, а не в модуле формы: форму обходят
// программная запись, ввод на основании и обмен данными, а модуль объекта —
// нет. Раньше здесь не было ничего, и документ можно было записать
// с незаполненными складами.
//
// Параметры:
//  Отказ                  - Булево
//  ПроверяемыеРеквизиты   - Массив
//
Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)

    Если ПриготавливаемыеБлюда.Количество() = 0 Тогда
        ОбщегоНазначения.СообщитьПользователю(
            "Не заполнен список приготавливаемых блюд", , "Объект.ПриготавливаемыеБлюда", , Отказ);
    КонецЕсли;

    Если НЕ ЗначениеЗаполнено(СкладСырья) Тогда
        ОбщегоНазначения.СообщитьПользователю(
            "Не заполнен склад сырья", , "Объект.СкладСырья", , Отказ);
    КонецЕсли;

    Если НЕ ЗначениеЗаполнено(СкладГотовойПродукции) Тогда
        ОбщегоНазначения.СообщитьПользователю(
            "Не заполнен склад готовой продукции", , "Объект.СкладГотовойПродукции", , Отказ);
    КонецЕсли;

    // Совпадение складов сырья и готовой продукции — нормальный сценарий
    // и здесь не проверяется: списывается сырьё, приходуется готовое блюдо,
    // это разная номенклатура, движения друг друга не гасят. В буфете
    // с одним складом иначе и не бывает.

    Для Каждого СтрокаБлюда Из ПриготавливаемыеБлюда Цикл

        ПутьКСтроке = "Объект.ПриготавливаемыеБлюда[" + (СтрокаБлюда.НомерСтроки - 1) + "]";

        Если НЕ ЗначениеЗаполнено(СтрокаБлюда.Блюдо) Тогда
            ОбщегоНазначения.СообщитьПользователю(
                "Не заполнено блюдо в строке " + СтрокаБлюда.НомерСтроки, ,
                ПутьКСтроке + ".Блюдо", , Отказ);
        КонецЕсли;

        Если СтрокаБлюда.КоличествоПорций <= 0 Тогда
            ОбщегоНазначения.СообщитьПользователю(
                "Количество порций в строке " + СтрокаБлюда.НомерСтроки + " должно быть больше нуля", ,
                ПутьКСтроке + ".КоличествоПорций", , Отказ);
        КонецЕсли;

        ПроверитьСоответствиеТехкарточки(СтрокаБлюда, ПутьКСтроке, Отказ);

    КонецЦикла;

КонецПроцедуры

// Проверяет, что выбранная рецептура относится именно к этому блюду.
//
// У блюда может быть несколько техкарточек, и выбор рецептуры делается
// вручную. Карточка чужого блюда означала бы, что списывается один состав,
// а приходуется другое изделие — молча и без единого признака в отчётах.
Процедура ПроверитьСоответствиеТехкарточки(СтрокаБлюда, ПутьКСтроке, Отказ)

    Техкарточка = РецептураСтроки(СтрокаБлюда);

    Если Техкарточка = Неопределено Или НЕ ЗначениеЗаполнено(СтрокаБлюда.Блюдо) Тогда
        Возврат;
    КонецЕсли;

    БлюдоКарточки = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Техкарточка, "ГотовоеБлюдо");

    Если БлюдоКарточки = СтрокаБлюда.Блюдо Тогда
        Возврат;
    КонецЕсли;

    ОбщегоНазначения.СообщитьПользователю(
        СтрШаблон("Техкарточка ""%1"" в строке %2 заведена для блюда ""%3"", а не для ""%4""",
            Техкарточка, СтрокаБлюда.НомерСтроки, БлюдоКарточки, СтрокаБлюда.Блюдо), ,
        ПутьКСтроке + ".Техкарточка", , Отказ);

КонецПроцедуры

Процедура ОбработкаПроведения(Отказ, РежимПроведения)

    // Контроль остатков до записи движений: без него документ списывал
    // сырьё в минус, а нехватка обнаруживалась только потом в отчётах.
    // Кнопка «Проверить наличие» на форме необязательна к нажатию,
    // поэтому проверка обязана быть здесь.
    ПроверитьОстаткиПередПроведением(Отказ);

    Если Отказ Тогда
        Возврат;
    КонецЕсли;

    // Записываем движения по регистрам
    ЗаписатьДвиженияПоРегистрам(Отказ);

КонецПроцедуры

Процедура ОбработкаОтменыПроведения(Отказ)

    // Очищаем движения по регистрам накопления
    Движения.ТоварыНаСкладах.Очистить();
    Движения.СвободныеОстатки.Очистить();

    Движения.ТоварыНаСкладах.Записывать = Истина;
    Движения.СвободныеОстатки.Записывать = Истина;

    // РегистрСведений.ПриготовлениеПоРецептам независимый: он не входит
    // в состав движений документа и очищается отдельно
    ОчиститьАналитикуПриготовления();

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Выводит диагностическое сообщение о ходе проведения.
//
// По умолчанию молчит. Проведение выдавало более десятка сообщений на каждый
// документ: при групповом перепроведении окно сообщений забивалось, а вывод
// заметно замедлял обработку.
//
// Как включить подробный вывод для разбора одного документа: задать
// в дополнительных свойствах объекта признак ПодробныйВыводПроведения.
// Например, из внешней обработки:
//   ДокументОбъект.ДополнительныеСвойства.Вставить("ПодробныйВыводПроведения", Истина);
//   ДокументОбъект.Записать(РежимЗаписиДокумента.Проведение);
//
Процедура ВывестиДиагностику(Текст)

    Подробно = Ложь;
    Если ДополнительныеСвойства.Свойство("ПодробныйВыводПроведения", Подробно) И Подробно = Истина Тогда
        Сообщить(Текст);
    КонецЕсли;

КонецПроцедуры

// Состав ингредиентов блюда с кэшированием в пределах одного проведения.
//
// Ключ кэша — «блюдо + техкарточка + количество порций»: одно и то же блюдо
// может встречаться в документе дважды, с разным количеством и по разным
// рецептурам. Без техкарточки в ключе вторая строка получила бы состав первой.
Функция СоставБлюда(Блюдо, КоличествоПорций, Техкарточка)

    Если КэшСостава = Неопределено Тогда
        КэшСостава = Новый Соответствие;
    КонецЕсли;

    Ключ = Строка(Блюдо) + "|" + Строка(Техкарточка) + "|" + Формат(КоличествоПорций, "ЧДЦ=3; ЧГ=0");

    Состав = КэшСостава.Получить(Ключ);
    Если Состав = Неопределено Тогда
        Состав = РасчетСебестоимостиМодуль.ПолучитьСоставИнгредиентовБлюда(
            Блюдо, КоличествоПорций, Техкарточка);
        КэшСостава.Вставить(Ключ, Состав);
    КонецЕсли;

    Возврат Состав;

КонецФункции

// Техкарточку строки читает общий модуль: своя копия этой функции
// разошлась бы с той, по которой считается потребность в ингредиентах,
// и контроль остатков проверял бы не ту рецептуру, что списывается.
Функция РецептураСтроки(СтрокаБлюда)

    Возврат РасчетСебестоимостиМодуль.ТехкарточкаСтроки(СтрокаБлюда);

КонецФункции

// Проверяет наличие ингредиентов на складе сырья на дату документа.
//
// Ставит Отказ, если сырья не хватает или у блюда нет техкарточки:
// провести приготовление, для которого нет ни сырья, ни рецептуры,
// значит получить недостоверные остатки.
//
// Нехватку сырья можно разрешить флажком «Разрешить списание в минус»
// в самом документе — тогда вместо отказа выводится предупреждение.
// Отсутствие техкарточки флажком не обходится: без состава списывать нечего.
//
// Проверку можно отключить целиком для конкретного документа — например,
// при первичном вводе остатков или переносе данных:
//   ДокументОбъект.ДополнительныеСвойства.Вставить("НеКонтролироватьОстатки", Истина);
//
Процедура ПроверитьОстаткиПередПроведением(Отказ)

    НеКонтролировать = Ложь;
    Если ДополнительныеСвойства.Свойство("НеКонтролироватьОстатки", НеКонтролировать)
        И НеКонтролировать = Истина Тогда
        Возврат;
    КонецЕсли;

    РазрешенМинус = СписаниеВМинусРазрешено();

    // Проход первый — на дату документа
    СписаноВМинус = ПроверитьОстаткиНаМомент(Отказ, РазрешенМинус, Дата, "на дату документа", Истина);

    // Проход второй — на текущий момент.
    //
    // Документ задним числом проходит проверку на свою дату (тогда сырьё
    // было), но сегодня остаток уже израсходован более поздними документами
    // и уходит в минус. Без этого прохода контроль пропускал именно такие
    // случаи, и списание в минус происходило при снятом флажке.
    Если ЗначениеЗаполнено(Дата) И Дата < ТекущаяДатаСеанса() Тогда
        СписаноВМинус = СписаноВМинус
            + ПроверитьОстаткиНаМомент(Отказ, РазрешенМинус, Неопределено, "на текущий момент", Ложь);
    КонецЕсли;

    Если СписаноВМинус > 0 Тогда
        ЗаписьЖурналаРегистрации("Приготовление блюда",
            УровеньЖурналаРегистрации.Предупреждение,
            Метаданные.Документы.ПриготовлениеБлюда,
            Ссылка,
            СтрШаблон("Проведено с разрешённым списанием в минус, ингредиентов с нехваткой: %1",
                Формат(СписаноВМинус, "ЧДЦ=0; ЧГ=0")));
    КонецЕсли;

КонецПроцедуры

// Один проход контроля остатков на указанный момент.
//
// Параметры:
//  Отказ           - Булево - устанавливается, если нехватка запрещена
//  РазрешенМинус   - Булево - нехватка выводится предупреждением, а не отказом
//  НаДату          - Дата, Неопределено - момент расчёта остатков; Неопределено — текущий
//  ОписаниеМомента - Строка - как назвать момент в сообщении пользователю
//  ПроверятьСостав - Булево - проверять ли отсутствие техкарточек (нужно один раз)
//
// Возвращаемое значение:
//  Число - сколько ингредиентов уходит в минус
//
Функция ПроверитьОстаткиНаМомент(Отказ, РазрешенМинус, НаДату, ОписаниеМомента, ПроверятьСостав)

    Результат = РасчетСебестоимостиМодуль.ПроверитьНаличиеИнгредиентов(
        ПриготавливаемыеБлюда, СкладСырья, НаДату);

    Если ПроверятьСостав Тогда
        Для Каждого Блюдо Из Результат.БлюдаБезСостава Цикл
            ОбщегоНазначения.СообщитьПользователю(
                СтрШаблон("Для блюда ""%1"" не найдена техкарточка с составом ингредиентов", Блюдо),
                Ссылка, , , Отказ);
        КонецЦикла;
    КонецЕсли;

    СписаноВМинус = 0;

    Для Каждого СтрокаПроверки Из Результат.Строки Цикл

        Если СтрокаПроверки.Хватает Тогда
            Продолжить;
        КонецЕсли;

        ТекстНехватки = СтрШаблон("ингредиента ""%1"" %2: требуется %3, на складе %4, недостаёт %5",
            СтрокаПроверки.Ингредиент,
            ОписаниеМомента,
            Формат(СтрокаПроверки.Требуется, "ЧДЦ=3"),
            Формат(СтрокаПроверки.Остаток, "ЧДЦ=3"),
            Формат(СтрокаПроверки.Недостаток, "ЧДЦ=3"));

        Если РазрешенМинус Тогда
            // Документ проводится, но остаток уходит в минус —
            // молчать об этом нельзя, иначе расхождение всплывёт в отчётах
            ОбщегоНазначения.СообщитьПользователю("Списание в минус " + ТекстНехватки, Ссылка);
            СписаноВМинус = СписаноВМинус + 1;
            Продолжить;
        КонецЕсли;

        ОбщегоНазначения.СообщитьПользователю("Не хватает " + ТекстНехватки, Ссылка, , , Отказ);

    КонецЦикла;

    Возврат СписаноВМинус;

КонецФункции

// Разрешено ли списывать ингредиенты в минус.
//
// Реквизит читается через ЭтотОбъект[...], а не напрямую: индексный доступ
// не проверяется при компиляции, поэтому модуль работает и до того, как
// реквизит создан в конфигураторе. Нет реквизита — контроль остатков
// работает как раньше, то есть запрещает минус.
Функция СписаниеВМинусРазрешено()

    Попытка
        Значение = ЭтотОбъект["РазрешитьСписаниеВМинус"];
    Исключение
        Возврат Ложь;
    КонецПопытки;

    Возврат Значение = Истина;

КонецФункции

Процедура ЗаписатьДвиженияПоРегистрам(Отказ)

    ВывестиДиагностику(">>> ЗАПИСЬ ВСЕХ ДВИЖЕНИЙ ДОКУМЕНТА <<<");

    // Собираем все ингредиенты для списания
    ТаблицаСписания = Новый ТаблицаЗначений;
    ТаблицаСписания.Колонки.Добавить("Ингредиент");
    ТаблицаСписания.Колонки.Добавить("Количество", Новый ОписаниеТипов("Число"));

    Для Каждого СтрокаБлюда Из ПриготавливаемыеБлюда Цикл
        Если ЗначениеЗаполнено(СтрокаБлюда.Блюдо) И СтрокаБлюда.КоличествоПорций > 0 Тогда
            СоставИнгредиентов = СоставБлюда(
                СтрокаБлюда.Блюдо, СтрокаБлюда.КоличествоПорций, РецептураСтроки(СтрокаБлюда));

            Для Каждого СтрокаИнгредиент Из СоставИнгредиентов Цикл
                Если ЗначениеЗаполнено(СтрокаИнгредиент.Ингредиент) И СтрокаИнгредиент.ОбщееКоличество > 0 Тогда
                    НайденнаяСтрока = ТаблицаСписания.Найти(СтрокаИнгредиент.Ингредиент, "Ингредиент");
                    Если НайденнаяСтрока = Неопределено Тогда
                        НоваяСтрока = ТаблицаСписания.Добавить();
                        НоваяСтрока.Ингредиент = СтрокаИнгредиент.Ингредиент;
                        НоваяСтрока.Количество = СтрокаИнгредиент.ОбщееКоличество;
                    Иначе
                        НайденнаяСтрока.Количество = НайденнаяСтрока.Количество + СтрокаИнгредиент.ОбщееКоличество;
                    КонецЕсли;
                КонецЕсли;
            КонецЦикла;
        КонецЕсли;
    КонецЦикла;

    ВывестиДиагностику("Собрано ингредиентов для списания: " + Формат(ТаблицаСписания.Количество(), "ЧГ=0"));
    ВывестиДиагностику("Готовых блюд для оприходования: " + Формат(ПриготавливаемыеБлюда.Количество(), "ЧГ=0"));

    // === ЗАПИСЬ В РЕГИСТР ТоварыНаСкладах ===
    Движения.ТоварыНаСкладах.Записывать = Истина;

    // 1. Списание ингредиентов
    ВывестиДиагностику("=== СПИСАНИЕ ИНГРЕДИЕНТОВ (ТоварыНаСкладах) ===");
    Для Каждого СтрокаСписания Из ТаблицаСписания Цикл
        Движение = Движения.ТоварыНаСкладах.Добавить();
        Движение.ВидДвижения = ВидДвиженияНакопления.Расход;
        Движение.Период = Дата;
        Движение.Номенклатура = СтрокаСписания.Ингредиент;
        Движение.Склад = СкладСырья;
        Движение.ВНаличии = СтрокаСписания.Количество;

        ВывестиДиагностику("  РАСХОД: " + Строка(СтрокаСписания.Ингредиент) + " - " + Формат(СтрокаСписания.Количество, "ЧДЦ=3") + " кг");
    КонецЦикла;

    // 2. Оприходование готовых блюд
    ВывестиДиагностику("=== ПРИХОД ГОТОВЫХ БЛЮД (ТоварыНаСкладах) ===");
    Для Каждого СтрокаБлюда Из ПриготавливаемыеБлюда Цикл
        Если ЗначениеЗаполнено(СтрокаБлюда.Блюдо) И СтрокаБлюда.КоличествоПорций > 0 Тогда
            Движение = Движения.ТоварыНаСкладах.Добавить();
            Движение.ВидДвижения = ВидДвиженияНакопления.Приход;
            Движение.Период = Дата;
            Движение.Номенклатура = СтрокаБлюда.Блюдо;
            Движение.Склад = СкладГотовойПродукции;
            Движение.ВНаличии = СтрокаБлюда.КоличествоПорций;

            ВывестиДиагностику("  ПРИХОД: " + Строка(СтрокаБлюда.Блюдо) + " - " + Формат(СтрокаБлюда.КоличествоПорций, "ЧГ=0") + " порций");
        КонецЕсли;
    КонецЦикла;

    // === ЗАПИСЬ В РЕГИСТР СвободныеОстатки ===
    ВывестиДиагностику(">>> ЗАПИСЬ В РЕГИСТР СвободныеОстатки <<<");
    Движения.СвободныеОстатки.Записывать = Истина;

    // 1. Списание ингредиентов
    ВывестиДиагностику("=== РАСХОД ИНГРЕДИЕНТОВ (СвободныеОстатки) ===");
    Для Каждого СтрокаСписания Из ТаблицаСписания Цикл
        Движение = Движения.СвободныеОстатки.Добавить();
        Движение.ВидДвижения = ВидДвиженияНакопления.Расход;
        Движение.Период = Дата;
        Движение.Номенклатура = СтрокаСписания.Ингредиент;
        Движение.Склад = СкладСырья;
        Движение.ВНаличии = СтрокаСписания.Количество;

        ВывестиДиагностику("  РАСХОД: " + Строка(СтрокаСписания.Ингредиент) + " - " + Формат(СтрокаСписания.Количество, "ЧДЦ=3") + " кг");
    КонецЦикла;

    // 2. Оприходование готовых блюд
    ВывестиДиагностику("=== ПРИХОД ГОТОВЫХ БЛЮД (СвободныеОстатки) ===");
    Для Каждого СтрокаБлюда Из ПриготавливаемыеБлюда Цикл
        Если ЗначениеЗаполнено(СтрокаБлюда.Блюдо) И СтрокаБлюда.КоличествоПорций > 0 Тогда
            Движение = Движения.СвободныеОстатки.Добавить();
            Движение.ВидДвижения = ВидДвиженияНакопления.Приход;
            Движение.Период = Дата;
            Движение.Номенклатура = СтрокаБлюда.Блюдо;
            Движение.Склад = СкладГотовойПродукции;
            Движение.ВНаличии = СтрокаБлюда.КоличествоПорций;

            ВывестиДиагностику("  ПРИХОД: " + Строка(СтрокаБлюда.Блюдо) + " - " + Формат(СтрокаБлюда.КоличествоПорций, "ЧГ=0") + " порций");
        КонецЕсли;
    КонецЦикла;

    // === ЗАПИСЬ АНАЛИТИКИ ПРИГОТОВЛЕНИЯ ===
    ЗаписатьАналитикуПриготовления();

    ВывестиДиагностику("=== ВСЕ ДВИЖЕНИЯ УСПЕШНО ЗАПИСАНЫ ===");

КонецПроцедуры

// Пишет аналитику в РегистрСведений.ПриготовлениеПоРецептам.
//
// Регистр НЕЗАВИСИМЫЙ (режим записи Independent), поэтому он не входит
// в состав движений документа — обращение вида
// Движения.ПриготовлениеПоРецептам здесь недопустимо.
//
// ВАЖНО про сохранность данных.
// Набор записей с отбором только по ДатаВремя удалял бы ВСЕ записи регистра
// за эту дату, включая созданные другими документами. Поэтому запись идёт
// менеджером записи — по каждому ключу измерений отдельно: существующая
// запись обновляется, отсутствующая создаётся, чужие не затрагиваются.
//
// Обратная сторона: если из документа убрали строку, её прежняя запись
// в регистре останется. Точное удаление возможно только при наличии
// измерения-регистратора — см. раздел инструкции «Аналитика приготовления».
Процедура ЗаписатьАналитикуПриготовления()

    ВывестиДиагностику(">>> ЗАПИСЬ АНАЛИТИКИ (РегистрСведений.ПриготовлениеПоРецептам) <<<");

    // Сначала собираем состав по всем блюдам, затем одним запросом получаем цены.
    // Запрос цены на каждый ингредиент внутри цикла давал бы сотни обращений к базе.
    СтрокиАналитики = Новый Массив;
    ВсеИнгредиенты = Новый Массив;

    Для Каждого СтрокаБлюда Из ПриготавливаемыеБлюда Цикл

        Если НЕ ЗначениеЗаполнено(СтрокаБлюда.Блюдо) Или СтрокаБлюда.КоличествоПорций <= 0 Тогда
            Продолжить;
        КонецЕсли;

        Рецепт = НайтиРецептДляБлюда(СтрокаБлюда.Блюдо);
        СоставИнгредиентов = СоставБлюда(
            СтрокаБлюда.Блюдо, СтрокаБлюда.КоличествоПорций, РецептураСтроки(СтрокаБлюда));

        Для Каждого СтрокаИнгредиент Из СоставИнгредиентов Цикл

            Если НЕ ЗначениеЗаполнено(СтрокаИнгредиент.Ингредиент) Или СтрокаИнгредиент.ОбщееКоличество <= 0 Тогда
                Продолжить;
            КонецЕсли;

            СтрокиАналитики.Добавить(Новый Структура(
                "Рецепт, Блюдо, Ингредиент, КоличествоПорций, Количество",
                Рецепт, СтрокаБлюда.Блюдо, СтрокаИнгредиент.Ингредиент,
                СтрокаБлюда.КоличествоПорций, СтрокаИнгредиент.ОбщееКоличество));

            Если ВсеИнгредиенты.Найти(СтрокаИнгредиент.Ингредиент) = Неопределено Тогда
                ВсеИнгредиенты.Добавить(СтрокаИнгредиент.Ингредиент);
            КонецЕсли;

        КонецЦикла;

    КонецЦикла;

    Цены = ПолучитьЦеныИнгредиентовПакетно(ВсеИнгредиенты);

    Для Каждого Данные Из СтрокиАналитики Цикл

        ЦенаЗаКг = Цены.Получить(Данные.Ингредиент);
        Если ЦенаЗаКг = Неопределено Тогда
            ЦенаЗаКг = 0;
        КонецЕсли;

        // Менеджер записи адресует ровно один ключ измерений:
        // соседние записи регистра остаются нетронутыми
        МенеджерЗаписи = РегистрыСведений.ПриготовлениеПоРецептам.СоздатьМенеджерЗаписи();
        МенеджерЗаписи.ДатаВремя = Дата;
        МенеджерЗаписи.Рецепт = Данные.Рецепт;
        МенеджерЗаписи.ГотовоеБлюдо = Данные.Блюдо;
        МенеджерЗаписи.Ингредиент = Данные.Ингредиент;
        МенеджерЗаписи.КоличествоПорций = Данные.КоличествоПорций;
        МенеджерЗаписи.КоличествоИнгредиента = Данные.Количество;
        МенеджерЗаписи.СтоимостьИнгредиента = Данные.Количество * ЦенаЗаКг;
        МенеджерЗаписи.СкладСырья = СкладСырья;
        МенеджерЗаписи.СкладГотовойПродукции = СкладГотовойПродукции;
        МенеджерЗаписи.Записать(Истина);

        ВывестиДиагностику("  АНАЛИТИКА: " + Строка(Данные.Блюдо) + " / " + Строка(Данные.Ингредиент)
            + " - " + Формат(Данные.Количество, "ЧДЦ=3"));

    КонецЦикла;

КонецПроцедуры

// Удаляет аналитику приготовления при отмене проведения.
//
// Удаляются только те ключи, которые этот документ записал бы сейчас —
// состав пересчитывается заново. Массовое удаление по дате недопустимо:
// оно снесло бы записи других документов за тот же момент времени.
Процедура ОчиститьАналитикуПриготовления()

    Для Каждого СтрокаБлюда Из ПриготавливаемыеБлюда Цикл

        Если НЕ ЗначениеЗаполнено(СтрокаБлюда.Блюдо) Или СтрокаБлюда.КоличествоПорций <= 0 Тогда
            Продолжить;
        КонецЕсли;

        Рецепт = НайтиРецептДляБлюда(СтрокаБлюда.Блюдо);
        СоставИнгредиентов = СоставБлюда(
            СтрокаБлюда.Блюдо, СтрокаБлюда.КоличествоПорций, РецептураСтроки(СтрокаБлюда));

        Для Каждого СтрокаИнгредиент Из СоставИнгредиентов Цикл

            Если НЕ ЗначениеЗаполнено(СтрокаИнгредиент.Ингредиент) Тогда
                Продолжить;
            КонецЕсли;

            МенеджерЗаписи = РегистрыСведений.ПриготовлениеПоРецептам.СоздатьМенеджерЗаписи();
            МенеджерЗаписи.ДатаВремя = Дата;
            МенеджерЗаписи.Рецепт = Рецепт;
            МенеджерЗаписи.ГотовоеБлюдо = СтрокаБлюда.Блюдо;
            МенеджерЗаписи.Ингредиент = СтрокаИнгредиент.Ингредиент;
            МенеджерЗаписи.Удалить();

        КонецЦикла;

    КонецЦикла;

КонецПроцедуры

// Ищет активный рецепт, привязанный к готовому блюду.
// Регистр ПриготовлениеПоРецептам хранит рецепт в измерении, поэтому для
// корректной аналитики его нужно определить. Если рецепта нет,
// запись всё равно создаётся — с пустым рецептом.
Функция НайтиРецептДляБлюда(ГотовоеБлюдо)

    Попытка
        Запрос = Новый Запрос;
        Запрос.Текст =
        "ВЫБРАТЬ ПЕРВЫЕ 1
        |    КулинарныеРецепты.Ссылка КАК Рецепт
        |ИЗ
        |    Справочник.КулинарныеРецепты КАК КулинарныеРецепты
        |ГДЕ
        |    КулинарныеРецепты.ГотовоеБлюдо = &ГотовоеБлюдо
        |    И НЕ КулинарныеРецепты.ПометкаУдаления";

        Запрос.УстановитьПараметр("ГотовоеБлюдо", ГотовоеБлюдо);

        Выборка = Запрос.Выполнить().Выбрать();
        Если Выборка.Следующий() Тогда
            Возврат Выборка.Рецепт;
        КонецЕсли;
    Исключение
        // Справочник рецептов может отсутствовать — аналитика пишется без рецепта
    КонецПопытки;

    Возврат Справочники.КулинарныеРецепты.ПустаяСсылка();

КонецФункции

// Цены за килограмм сразу по всем ингредиентам документа.
//
// Цены берутся на дату документа, а не текущие: иначе перепроведение
// прошлогоднего документа переоценило бы его по сегодняшнему прайсу
// и себестоимость в закрытом периоде поехала бы задним числом.
//
// Возвращаемое значение:
//  Соответствие - ключ: номенклатура, значение: цена за килограмм
//
Функция ПолучитьЦеныИнгредиентовПакетно(МассивИнгредиентов)

    Если МассивИнгредиентов.Количество() = 0 Тогда
        Возврат Новый Соответствие;
    КонецЕсли;

    Попытка
        Возврат РасчетСебестоимостиМодуль.ПолучитьЦеныИнгредиентов(
            МассивИнгредиентов, Неопределено, Дата).ПоИнгредиенту;
    Исключение
        // Общий модуль расчёта может отсутствовать — аналитика пишется без стоимости
        Возврат Новый Соответствие;
    КонецПопытки;

КонецФункции

// Состав техкарточки и перевод нормы вынесены в общий модуль
// РасчетСебестоимостиМодуль: раньше эти функции были продублированы здесь
// и в модуле формы, и расхождение между копиями означало, что проверка
// наличия и фактическое списание считают разные количества.

#КонецОбласти

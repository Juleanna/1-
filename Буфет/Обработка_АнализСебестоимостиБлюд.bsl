// Модуль объекта обработки "Анализ себестоимости блюд"
// Анализ себестоимости и использования ингредиентов по данным
// РегистрСведений.ПриготовлениеПоРецептам.
//
// Директивы компиляции (&НаСервере, &НаКлиенте) в модуле объекта обработки
// не указываются: модуль целиком исполняется на сервере.
//
// ВНИМАНИЕ: обработки АнализСебестоимостиБлюд нет в текущем составе расширения
// «Буфет» — её нужно создать. Порядок описан в разделе инструкции
// «Аналитика приготовления».

#Область ПрограммныйИнтерфейс

Функция ПолучитьДанныеДляАнализа(ПараметрыОтчета) Экспорт
    
    НачалоПериода = ПараметрыОтчета.НачалоПериода;
    КонецПериода = ПараметрыОтчета.КонецПериода;
    Склад = ПараметрыОтчета.Склад;
    
    // Формируем отчет по использованию ингредиентов
    ТаблицаРезультат = Новый ТаблицаЗначений;
    ТаблицаРезультат.Колонки.Добавить("Рецепт", Новый ОписаниеТипов("СправочникСсылка.КулинарныеРецепты"));
    ТаблицаРезультат.Колонки.Добавить("ГотовоеБлюдо", Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
    ТаблицаРезультат.Колонки.Добавить("КоличествоПорций", Новый ОписаниеТипов("Число"));
    ТаблицаРезультат.Колонки.Добавить("СуммарнаяСебестоимость", Новый ОписаниеТипов("Число"));
    ТаблицаРезультат.Колонки.Добавить("СебестоимостьПорции", Новый ОписаниеТипов("Число"));
    ТаблицаРезультат.Колонки.Добавить("КоличествоИнгредиентов", Новый ОписаниеТипов("Число"));
    
    // Данные берём из РегистрСведений.ПриготовлениеПоРецептам.
    // КоличествоПорций записано в КАЖДОЙ строке "блюдо + ингредиент", поэтому
    // суммировать его напрямую нельзя — получится завышение в число ингредиентов.
    // Сначала сворачиваем до уровня "дата + рецепт + блюдо" через МАКСИМУМ,
    // и только потом суммируем порции по блюду.
    Запрос = Новый Запрос;
    Запрос.Текст =
    "ВЫБРАТЬ
    |    Приготовление.Рецепт КАК Рецепт,
    |    Приготовление.ГотовоеБлюдо КАК ГотовоеБлюдо,
    |    Приготовление.ДатаВремя КАК ДатаВремя,
    |    МАКСИМУМ(Приготовление.КоличествоПорций) КАК КоличествоПорций,
    |    СУММА(Приготовление.СтоимостьИнгредиента) КАК СуммарнаяСебестоимость,
    |    КОЛИЧЕСТВО(РАЗЛИЧНЫЕ Приготовление.Ингредиент) КАК КоличествоИнгредиентов
    |ПОМЕСТИТЬ ПоПриготовлениям
    |ИЗ
    |    РегистрСведений.ПриготовлениеПоРецептам КАК Приготовление
    |ГДЕ
    |    Приготовление.ДатаВремя МЕЖДУ &НачалоПериода И &КонецПериода
    |    &ОтборСклад
    |СГРУППИРОВАТЬ ПО
    |    Приготовление.Рецепт,
    |    Приготовление.ГотовоеБлюдо,
    |    Приготовление.ДатаВремя
    |;
    |
    |////////////////////////////////////////////////////////////////////////////////
    |ВЫБРАТЬ
    |    ПоПриготовлениям.Рецепт КАК Рецепт,
    |    ПоПриготовлениям.ГотовоеБлюдо КАК ГотовоеБлюдо,
    |    СУММА(ПоПриготовлениям.КоличествоПорций) КАК КоличествоПорций,
    |    СУММА(ПоПриготовлениям.СуммарнаяСебестоимость) КАК СуммарнаяСебестоимость,
    |    МАКСИМУМ(ПоПриготовлениям.КоличествоИнгредиентов) КАК КоличествоИнгредиентов
    |ИЗ
    |    ПоПриготовлениям КАК ПоПриготовлениям
    |СГРУППИРОВАТЬ ПО
    |    ПоПриготовлениям.Рецепт,
    |    ПоПриготовлениям.ГотовоеБлюдо";

    Запрос.УстановитьПараметр("НачалоПериода", НачалоПериода);
    Запрос.УстановитьПараметр("КонецПериода", КонецПериода);

    // Склад в этом регистре — ресурс, а не измерение, поэтому отбор идёт условием
    Если ЗначениеЗаполнено(Склад) Тогда
        Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ОтборСклад", "И Приготовление.СкладСырья = &Склад");
        Запрос.УстановитьПараметр("Склад", Склад);
    Иначе
        Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ОтборСклад", "");
    КонецЕсли;

    Результат = Запрос.ВыполнитьПакет()[1];
    Выборка = Результат.Выбрать();
    
    Пока Выборка.Следующий() Цикл
        
        НоваяСтрока = ТаблицаРезультат.Добавить();
        ЗаполнитьЗначенияСвойств(НоваяСтрока, Выборка);
        
        // Рассчитываем себестоимость порции
        Если Выборка.КоличествоПорций > 0 Тогда
            НоваяСтрока.СебестоимостьПорции = Выборка.СуммарнаяСебестоимость / Выборка.КоличествоПорций;
        КонецЕсли;
        
    КонецЦикла;
    
    Возврат ТаблицаРезультат;
    
КонецФункции

Функция ПолучитьДетализациюПоИнгредиентам(Рецепт, НачалоПериода, КонецПериода, Склад = Неопределено) Экспорт
    
    Запрос = Новый Запрос;
    Запрос.Текст =
    "ВЫБРАТЬ
    |    Приготовление.Ингредиент КАК Ингредиент,
    |    СУММА(Приготовление.КоличествоИнгредиента) КАК КоличествоИспользовано,
    |    СУММА(Приготовление.СтоимостьИнгредиента) КАК СтоимостьИспользовано,
    |    ВЫБОР
    |        КОГДА СУММА(Приготовление.КоличествоИнгредиента) > 0
    |            ТОГДА СУММА(Приготовление.СтоимостьИнгредиента) / СУММА(Приготовление.КоличествоИнгредиента)
    |        ИНАЧЕ 0
    |    КОНЕЦ КАК СредняяЦенаЗаПериод
    |ИЗ
    |    РегистрСведений.ПриготовлениеПоРецептам КАК Приготовление
    |ГДЕ
    |    Приготовление.ДатаВремя МЕЖДУ &НачалоПериода И &КонецПериода
    |    И Приготовление.Рецепт = &Рецепт
    |    И Приготовление.КоличествоИнгредиента > 0
    |    &ОтборСклад
    |СГРУППИРОВАТЬ ПО
    |    Приготовление.Ингредиент
    |УПОРЯДОЧИТЬ ПО
    |    СтоимостьИспользовано УБЫВ";

    Запрос.УстановитьПараметр("НачалоПериода", НачалоПериода);
    Запрос.УстановитьПараметр("КонецПериода", КонецПериода);
    Запрос.УстановитьПараметр("Рецепт", Рецепт);

    Если ЗначениеЗаполнено(Склад) Тогда
        Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ОтборСклад", "И Приготовление.СкладСырья = &Склад");
        Запрос.УстановитьПараметр("Склад", Склад);
    Иначе
        Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ОтборСклад", "");
    КонецЕсли;

    Возврат Запрос.Выполнить().Выгрузить();

КонецФункции

Функция РассчитатьПрогнозныеПотребности(РецептыДляРасчета, ПрогнозПродаж = Неопределено) Экспорт

    // РецептыДляРасчета - таблица с колонками: Рецепт, КоличествоПланируемыхПорций
    // Возвращает таблицу потребностей в ингредиентах

    ТаблицаПотребностей = Новый ТаблицаЗначений;
    ТаблицаПотребностей.Колонки.Добавить("Ингредиент", Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
    // Единицы измерения в УТ 11 — справочник упаковок, а не классификатор
    ТаблицаПотребностей.Колонки.Добавить("ЕдиницаИзмерения", Новый ОписаниеТипов("СправочникСсылка.УпаковкиЕдиницыИзмерения"));
    ТаблицаПотребностей.Колонки.Добавить("ПотребноеКоличество", Новый ОписаниеТипов("Число"));
    ТаблицаПотребностей.Колонки.Добавить("ПредполагаемаяСтоимость", Новый ОписаниеТипов("Число"));
    ТаблицаПотребностей.Колонки.Добавить("КоличествоРецептов", Новый ОписаниеТипов("Число"));
    
    Для Каждого СтрокаРецепта Из РецептыДляРасчета Цикл
        
        // Получаем состав ингредиентов для рецепта
        СоставИнгредиентов = ПолучитьСоставИнгредиентовРецепта(СтрокаРецепта.Рецепт);
        
        Для Каждого СтрокаИнгредиент Из СоставИнгредиентов Цикл

            // Защита от деления на ноль: в рецепте количество порций может быть не заполнено
            Если СтрокаИнгредиент.КоличествоПорцийВРецепте <= 0 Тогда
                Продолжить;
            КонецЕсли;

            КоличествоНаПорцию = СтрокаИнгредиент.Количество / СтрокаИнгредиент.КоличествоПорцийВРецепте;
            ТребуемоеКоличество = КоличествоНаПорцию * СтрокаРецепта.КоличествоПланируемыхПорций;

            // Ищем ингредиент в таблице потребностей
            СтрокиИнгредиента = ТаблицаПотребностей.НайтиСтроки(Новый Структура("Ингредиент", СтрокаИнгредиент.Ингредиент));
            
            Если СтрокиИнгредиента.Количество() > 0 Тогда
                // Увеличиваем потребность
                СтрокаПотребности = СтрокиИнгредиента[0];
                СтрокаПотребности.ПотребноеКоличество = СтрокаПотребности.ПотребноеКоличество + ТребуемоеКоличество;
                СтрокаПотребности.ПредполагаемаяСтоимость = СтрокаПотребности.ПредполагаемаяСтоимость + ТребуемоеКоличество * СтрокаИнгредиент.СтоимостьЕдиницы;
                СтрокаПотребности.КоличествоРецептов = СтрокаПотребности.КоличествоРецептов + 1;
            Иначе
                // Добавляем новый ингредиент
                НоваяСтрока = ТаблицаПотребностей.Добавить();
                НоваяСтрока.Ингредиент = СтрокаИнгредиент.Ингредиент;
                НоваяСтрока.ЕдиницаИзмерения = СтрокаИнгредиент.ЕдиницаИзмерения;
                НоваяСтрока.ПотребноеКоличество = ТребуемоеКоличество;
                НоваяСтрока.ПредполагаемаяСтоимость = ТребуемоеКоличество * СтрокаИнгредиент.СтоимостьЕдиницы;
                НоваяСтрока.КоличествоРецептов = 1;
            КонецЕсли;
            
        КонецЦикла;
        
    КонецЦикла;
    
    // Сортируем по убыванию стоимости
    ТаблицаПотребностей.Сортировать("ПредполагаемаяСтоимость УБЫВ");
    
    Возврат ТаблицаПотребностей;
    
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Состав ингредиентов рецепта.
//
// После перехода на технологические карты табличная часть
// Справочник.КулинарныеРецепты.СоставИнгредиентов удалена, а состав хранится
// в техкарточке, на которую ссылается реквизит рецепта "Техкарточка".
// Норма брутто в техкарточке задана в граммах на одну порцию.
//
// Параметры:
//  Рецепт - СправочникСсылка.КулинарныеРецепты
//
// Возвращаемое значение:
//  ТаблицаЗначений - Ингредиент, Количество (кг), ЕдиницаИзмерения,
//                    СтоимостьЕдиницы (грн/кг), КоличествоПорцийВРецепте
//
Функция ПолучитьСоставИнгредиентовРецепта(Рецепт)

    Запрос = Новый Запрос;
    Запрос.Текст =
    "ВЫБРАТЬ
    |    ТехкарточкиСоставИнгредиентов.Ингредиент КАК Ингредиент,
    |    ТехкарточкиСоставИнгредиентов.НормаБрутто / 1000 КАК Количество,
    |    ТехкарточкиСоставИнгредиентов.Ингредиент.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
    |    ТехкарточкиСоставИнгредиентов.СтоимостьЕдиницы КАК СтоимостьЕдиницы,
    |    ВЫБОР
    |        КОГДА КулинарныеРецепты.КоличествоПорций > 0
    |            ТОГДА КулинарныеРецепты.КоличествоПорций
    |        ИНАЧЕ 1
    |    КОНЕЦ КАК КоличествоПорцийВРецепте
    |ИЗ
    |    Справочник.КулинарныеРецепты КАК КулинарныеРецепты
    |        ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Техкарточки.СоставИнгредиентов КАК ТехкарточкиСоставИнгредиентов
    |        ПО КулинарныеРецепты.Техкарточка = ТехкарточкиСоставИнгредиентов.Ссылка
    |ГДЕ
    |    КулинарныеРецепты.Ссылка = &Рецепт
    |    И ТехкарточкиСоставИнгредиентов.НормаБрутто > 0
    |    И НЕ ТехкарточкиСоставИнгредиентов.Ссылка.ПометкаУдаления";

    Запрос.УстановитьПараметр("Рецепт", Рецепт);

    Возврат Запрос.Выполнить().Выгрузить();

КонецФункции

#КонецОбласти
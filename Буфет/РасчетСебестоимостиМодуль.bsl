////////////////////////////////////////////////////////////////////////////////
// МОДУЛЬ ДЛЯ РАСЧЕТА СЕБЕСТОИМОСТИ БЛЮД
// Автоматический расчет на основе цен ингредиентов из справочника
//
// Флаги общего модуля: Сервер, Вызов сервера.
//
// Цены получаются пакетно: один запрос на всю техкарточку, а не по запросу
// на каждую строку состава. Точечная функция ПолучитьЦенуИнгредиента
// оставлена для единичных обращений из форм.
////////////////////////////////////////////////////////////////////////////////

#Область ПрограммныйИнтерфейс

// Рассчитать себестоимость техкарточки
//
// Параметры:
//  ТехКарточкаСсылка - СправочникСсылка.Техкарточки - Ссылка на технологическую карту
//
// Возвращаемое значение:
//  Число - Себестоимость одной порции
//
Функция РассчитатьСебестоимостьТехКарточки(ТехКарточкаСсылка) Экспорт

	Если НЕ ЗначениеЗаполнено(ТехКарточкаСсылка) Тогда
		Возврат 0;
	КонецЕсли;

	// Расчёт служебный: пользователю может быть закрыт доступ к ценам,
	// но себестоимость всё равно должна считаться
	УстановитьПривилегированныйРежим(Истина);

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ТехкарточкиСоставИнгредиентов.Ингредиент КАК Ингредиент,
	|	ТехкарточкиСоставИнгредиентов.НормаБрутто КАК НормаБрутто,
	|	ТехкарточкиСоставИнгредиентов.ЦенаИнгредиента КАК ЦенаИнгредиента
	|ИЗ
	|	Справочник.Техкарточки.СоставИнгредиентов КАК ТехкарточкиСоставИнгредиентов
	|ГДЕ
	|	ТехкарточкиСоставИнгредиентов.Ссылка = &ТехКарточка
	|	И ТехкарточкиСоставИнгредиентов.НормаБрутто > 0";

	Запрос.УстановитьПараметр("ТехКарточка", ТехКарточкаСсылка);

	СтрокиСостава = Запрос.Выполнить().Выгрузить();

	Если СтрокиСостава.Количество() = 0 Тогда
		Возврат 0;
	КонецЕсли;

	// Один запрос на все цены вместо запроса на каждую строку
	Цены = ПолучитьЦеныИнгредиентов(
		СтрокиСостава.ВыгрузитьКолонку("Ингредиент"),
		СтрокиСостава.ВыгрузитьКолонку("ЦенаИнгредиента"));

	ОбщаяСебестоимость = 0;

	Для Каждого СтрокаСостава Из СтрокиСостава Цикл

		ЦенаЗаКг = ЦенаИзКеша(Цены, СтрокаСостава.Ингредиент, СтрокаСостава.ЦенаИнгредиента);

		// НормаБрутто в граммах, цена за килограмм
		ОбщаяСебестоимость = ОбщаяСебестоимость + (СтрокаСостава.НормаБрутто / 1000) * ЦенаЗаКг;

	КонецЦикла;

	Возврат ОбщаяСебестоимость;

КонецФункции

// Получить цены сразу по списку ингредиентов — один запрос вместо N.
//
// Параметры:
//  МассивИнгредиентов - Массив - номенклатура, для которой нужны цены
//  МассивСсылокНаЦены - Массив - явно указанные элементы ЦеныНаИнгредиенты (может быть пустым)
//  НаДату             - Дата   - на какой момент нужна цена.
//                                Пустое значение — текущая активная цена.
//                                Документы передают свою дату, чтобы
//                                перепроведение не пересчитывало прошлый период
//                                по сегодняшним ценам.
//
// Возвращаемое значение:
//  Структура:
//   * ПоСсылке      - Соответствие - ключ: ссылка ЦеныНаИнгредиенты, значение: цена за кг
//   * ПоИнгредиенту - Соответствие - ключ: номенклатура, значение: цена за кг на указанную дату
//
Функция ПолучитьЦеныИнгредиентов(МассивИнгредиентов, МассивСсылокНаЦены = Неопределено, НаДату = Неопределено) Экспорт

	Результат = Новый Структура("ПоСсылке, ПоИнгредиенту", Новый Соответствие, Новый Соответствие);

	Если МассивИнгредиентов = Неопределено Или МассивИнгредиентов.Количество() = 0 Тогда
		Возврат Результат;
	КонецЕсли;

	УстановитьПривилегированныйРежим(Истина);

	СписокЦен = ?(МассивСсылокНаЦены = Неопределено, Новый Массив, МассивСсылокНаЦены);

	// Пустая дата означает «текущая цена»: берём заведомо будущую границу,
	// чтобы одно и то же условие работало в обоих режимах
	ГраницаДаты = ?(ЗначениеЗаполнено(НаДату), КонецДня(НаДату), '39991231235959');

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Цены.Ссылка КАК Ссылка,
	|	Цены.ЦенаЗаЕдиницу КАК ЦенаЗаЕдиницу,
	|	Цены.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
	|	%ВесНоменклатуры% КАК ВесНоменклатуры
	|ИЗ
	|	Справочник.ЦеныНаИнгредиенты КАК Цены
	|ГДЕ
	|	Цены.Ссылка В (&СписокЦен)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Цены.Ингредиент КАК Ингредиент,
	|	МАКСИМУМ(Цены.ДатаУстановкиЦены) КАК ДатаУстановкиЦены
	|ПОМЕСТИТЬ ПоследниеДаты
	|ИЗ
	|	Справочник.ЦеныНаИнгредиенты КАК Цены
	|ГДЕ
	|	Цены.Ингредиент В (&СписокИнгредиентов)
	|	И Цены.Активность
	|	И НЕ Цены.ПометкаУдаления
	|	И Цены.ДатаУстановкиЦены <= &ГраницаДаты
	|СГРУППИРОВАТЬ ПО
	|	Цены.Ингредиент
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Цены.Ингредиент КАК Ингредиент,
	|	Цены.ЦенаЗаЕдиницу КАК ЦенаЗаЕдиницу,
	|	Цены.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
	|	%ВесНоменклатуры% КАК ВесНоменклатуры
	|ИЗ
	|	ПоследниеДаты КАК ПоследниеДаты
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ЦеныНаИнгредиенты КАК Цены
	|		ПО ПоследниеДаты.Ингредиент = Цены.Ингредиент
	|			И ПоследниеДаты.ДатаУстановкиЦены = Цены.ДатаУстановкиЦены
	|ГДЕ
	|	Цены.Активность
	|	И НЕ Цены.ПометкаУдаления";

	Запрос.Текст = СтрЗаменить(Запрос.Текст, "%ВесНоменклатуры%", ВыражениеВесаЕдиницы("Цены.Ингредиент"));

	Запрос.УстановитьПараметр("СписокЦен", СписокЦен);
	Запрос.УстановитьПараметр("СписокИнгредиентов", МассивИнгредиентов);
	Запрос.УстановитьПараметр("ГраницаДаты", ГраницаДаты);

	Попытка
		Пакет = Запрос.ВыполнитьПакет();
	Исключение
		// Вес прочитать не удалось — считаем цену уже приведённой
		// к единице измерения, указанной в самой цене
		Запрос.Текст = СтрЗаменить(Запрос.Текст,
			ВыражениеВесаЕдиницы("Цены.Ингредиент") + " КАК ВесНоменклатуры", "0 КАК ВесНоменклатуры");
		Пакет = Запрос.ВыполнитьПакет();
	КонецПопытки;

	ВыборкаПоСсылке = Пакет[0].Выбрать();
	Пока ВыборкаПоСсылке.Следующий() Цикл
		Результат.ПоСсылке.Вставить(ВыборкаПоСсылке.Ссылка,
			ПривестиЦенуККилограммам(ВыборкаПоСсылке.ЦенаЗаЕдиницу, ВыборкаПоСсылке.ЕдиницаИзмерения,
				ВыборкаПоСсылке.ВесНоменклатуры));
	КонецЦикла;

	ВыборкаПоИнгредиенту = Пакет[2].Выбрать();
	Пока ВыборкаПоИнгредиенту.Следующий() Цикл
		// Если на одну дату заведено несколько активных цен, берём первую попавшуюся
		Если Результат.ПоИнгредиенту.Получить(ВыборкаПоИнгредиенту.Ингредиент) = Неопределено Тогда
			Результат.ПоИнгредиенту.Вставить(ВыборкаПоИнгредиенту.Ингредиент,
				ПривестиЦенуККилограммам(ВыборкаПоИнгредиенту.ЦенаЗаЕдиницу, ВыборкаПоИнгредиенту.ЕдиницаИзмерения,
					ВыборкаПоИнгредиенту.ВесНоменклатуры));
		КонецЕсли;
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Получить цену одного ингредиента.
//
// Для обработки нескольких строк используйте ПолучитьЦеныИнгредиентов —
// она делает один запрос вместо запроса на каждый ингредиент.
//
// Цена берётся текущая активная, без привязки к дате: при перепроведении
// старого документа себестоимость пересчитается по сегодняшней цене.
//
// Параметры:
//  Ингредиент - СправочникСсылка.Номенклатура - Ингредиент
//  ЦенаИнгредиента - СправочникСсылка.ЦеныНаИнгредиенты - Ссылка на цену (необязательно)
//
// Возвращаемое значение:
//  Число - Цена за килограмм
//
Функция ПолучитьЦенуИнгредиента(Ингредиент, ЦенаИнгредиента = Неопределено) Экспорт

	Если НЕ ЗначениеЗаполнено(Ингредиент) Тогда
		Возврат 0;
	КонецЕсли;

	Ингредиенты = Новый Массив;
	Ингредиенты.Добавить(Ингредиент);

	СсылкиНаЦены = Новый Массив;
	Если ЗначениеЗаполнено(ЦенаИнгредиента) Тогда
		СсылкиНаЦены.Добавить(ЦенаИнгредиента);
	КонецЕсли;

	Цены = ПолучитьЦеныИнгредиентов(Ингредиенты, СсылкиНаЦены);

	Возврат ЦенаИзКеша(Цены, Ингредиент, ЦенаИнгредиента);

КонецФункции

// Автоматически обновить цены в строках техкарточки
//
// Параметры:
//  ТехКарточкаОбъект - СправочникОбъект.Техкарточки - Объект технологической карты
//
Процедура ОбновитьЦеныВТехКарточке(ТехКарточкаОбъект) Экспорт

	Если ТехКарточкаОбъект = Неопределено Тогда
		Возврат;
	КонецЕсли;

	// Собираем ингредиенты и явные ссылки на цены, чтобы запросить всё одним пакетом
	Ингредиенты = Новый Массив;
	СсылкиНаЦены = Новый Массив;

	Для Каждого СтрокаИнгредиент Из ТехКарточкаОбъект.СоставИнгредиентов Цикл
		Если ЗначениеЗаполнено(СтрокаИнгредиент.Ингредиент) Тогда
			Ингредиенты.Добавить(СтрокаИнгредиент.Ингредиент);
		КонецЕсли;
		Если ЗначениеЗаполнено(СтрокаИнгредиент.ЦенаИнгредиента) Тогда
			СсылкиНаЦены.Добавить(СтрокаИнгредиент.ЦенаИнгредиента);
		КонецЕсли;
	КонецЦикла;

	Цены = ПолучитьЦеныИнгредиентов(Ингредиенты, СсылкиНаЦены);

	Для Каждого СтрокаИнгредиент Из ТехКарточкаОбъект.СоставИнгредиентов Цикл

		ЦенаЗаКг = ЦенаИзКеша(Цены, СтрокаИнгредиент.Ингредиент, СтрокаИнгредиент.ЦенаИнгредиента);

		СтрокаИнгредиент.СтоимостьЕдиницы = ЦенаЗаКг;

		// Рассчитываем общую стоимость ингредиента в рецепте
		Если СтрокаИнгредиент.НормаБрутто > 0 Тогда
			СтрокаИнгредиент.СуммаСтоимости = (СтрокаИнгредиент.НормаБрутто / 1000) * ЦенаЗаКг;
		Иначе
			СтрокаИнгредиент.СуммаСтоимости = 0;
		КонецЕсли;

	КонецЦикла;

	// Рассчитываем общую себестоимость порции
	ТехКарточкаОбъект.СебестоимостьПорции = РассчитатьОбщуюСебестоимость(ТехКарточкаОбъект);

КонецПроцедуры

// Обновить цены во всех технологических картах, использующих ингредиент
//
// Параметры:
//  Ингредиент - СправочникСсылка.Номенклатура - Ингредиент
//
Процедура ОбновитьЦеныПоИнгредиенту(Ингредиент) Экспорт

	Если НЕ ЗначениеЗаполнено(Ингредиент) Тогда
		Возврат;
	КонецЕсли;

	// Находим все техкарточки, использующие данный ингредиент
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ТехкарточкиСоставИнгредиентов.Ссылка КАК ТехКарточка
	|ИЗ
	|	Справочник.Техкарточки.СоставИнгредиентов КАК ТехкарточкиСоставИнгредиентов
	|ГДЕ
	|	ТехкарточкиСоставИнгредиентов.Ингредиент = &Ингредиент
	|	И НЕ ТехкарточкиСоставИнгредиентов.Ссылка.ПометкаУдаления";

	Запрос.УстановитьПараметр("Ингредиент", Ингредиент);

	РезультатЗапроса = Запрос.Выполнить();

	Если РезультатЗапроса.Пустой() Тогда
		Возврат;
	КонецЕсли;

	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();

	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл

		Попытка
			ОбновитьОднуТехКарточку(ВыборкаДетальныеЗаписи.ТехКарточка);
		Исключение
			// Логируем ошибку, но продолжаем обработку остальных техкарточек
			ЗаписьЖурналаРегистрации("Обновление цен",
				УровеньЖурналаРегистрации.Ошибка,
				Метаданные.Справочники.Техкарточки,
				ВыборкаДетальныеЗаписи.ТехКарточка,
				"Ошибка при обновлении цен в техкарточке: " + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		КонецПопытки;

	КонецЦикла;

КонецПроцедуры

// Пересчитывает одну техкарточку и записывает её только при реальном изменении.
//
// Лишние записи здесь дорого стоят: процедура вызывается из ПриЗаписи цены
// и может затронуть сотни техкарточек, а каждая запись — это ещё и вызов
// ПередЗаписью самой техкарточки.
Процедура ОбновитьОднуТехКарточку(ТехКарточкаСсылка)

	НачатьТранзакцию();

	Попытка

		Блокировка = Новый БлокировкаДанных;
		ЭлементБлокировки = Блокировка.Добавить("Справочник.Техкарточки");
		ЭлементБлокировки.УстановитьЗначение("Ссылка", ТехКарточкаСсылка);
		Блокировка.Заблокировать();

		ТехКарточкаОбъект = ТехКарточкаСсылка.ПолучитьОбъект();

		Если ТехКарточкаОбъект = Неопределено Тогда
			ОтменитьТранзакцию();
			Возврат;
		КонецЕсли;

		СтараяСебестоимость = ТехКарточкаОбъект.СебестоимостьПорции;
		СтарыеСуммы = Новый Массив;
		Для Каждого СтрокаИнгредиент Из ТехКарточкаОбъект.СоставИнгредиентов Цикл
			СтарыеСуммы.Добавить(СтрокаИнгредиент.СуммаСтоимости);
		КонецЦикла;

		ОбновитьЦеныВТехКарточке(ТехКарточкаОбъект);

		Если ЕстьИзменения(ТехКарточкаОбъект, СтараяСебестоимость, СтарыеСуммы) Тогда
			ТехКарточкаОбъект.Записать();
		КонецЕсли;

		ЗафиксироватьТранзакцию();

	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;

КонецПроцедуры

// Проверяет, изменились ли суммы после пересчёта.
Функция ЕстьИзменения(ТехКарточкаОбъект, СтараяСебестоимость, СтарыеСуммы)

	Если Окр(ТехКарточкаОбъект.СебестоимостьПорции, 2) <> Окр(СтараяСебестоимость, 2) Тогда
		Возврат Истина;
	КонецЕсли;

	Индекс = 0;
	Для Каждого СтрокаИнгредиент Из ТехКарточкаОбъект.СоставИнгредиентов Цикл

		Если Индекс >= СтарыеСуммы.Количество() Тогда
			Возврат Истина;
		КонецЕсли;

		Если Окр(СтрокаИнгредиент.СуммаСтоимости, 2) <> Окр(СтарыеСуммы[Индекс], 2) Тогда
			Возврат Истина;
		КонецЕсли;

		Индекс = Индекс + 1;

	КонецЦикла;

	Возврат Ложь;

КонецФункции

// Получить цену ингредиента (серверный вызов для клиентских форм)
//
// Параметры:
//  Ингредиент - СправочникСсылка.Номенклатура - Ингредиент
//  ЦенаИнгредиента - СправочникСсылка.ЦеныНаИнгредиенты - Ссылка на цену
//
// Возвращаемое значение:
//  Число - Цена за килограмм
//
Функция ПолучитьЦенуИнгредиентаДляФормы(Ингредиент, ЦенаИнгредиента = Неопределено) Экспорт

	Возврат ПолучитьЦенуИнгредиента(Ингредиент, ЦенаИнгредиента);

КонецФункции

// Выбирает состав техкарточки блюда вместе с характеристиками единицы измерения.
//
// Единая точка для формы документа и модуля объекта: раньше запрос был
// продублирован в обоих модулях, и любое расхождение между копиями означало,
// что проверка наличия и фактическое списание считают разные количества.
//
// Ограничение ПЕРВЫЕ 1 обязательно: если у блюда заведено несколько
// техкарточек, состав всех сразу дал бы кратно завышенное списание.
//
// Параметры:
//  ГотовоеБлюдо - СправочникСсылка.Номенклатура
//
// Возвращаемое значение:
//  ВыборкаИзРезультатаЗапроса - Ингредиент, НормаБрутто, ЕдиницаНормы, ВесЕдиницы, ИмяЕдиницы
//  Неопределено - техкарточка не найдена или запрос не выполнился
//
Функция ВыбратьСоставТехкарточки(ГотовоеБлюдо) Экспорт

	Если НЕ ЗначениеЗаполнено(ГотовоеБлюдо) Тогда
		Возврат Неопределено;
	КонецЕсли;

	УстановитьПривилегированныйРежим(Истина);

	ТекстВыбораКарточки =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Техкарточки.Ссылка КАК Техкарточка
	|ПОМЕСТИТЬ ВыбраннаяКарточка
	|ИЗ
	|	Справочник.Техкарточки КАК Техкарточки
	|ГДЕ
	|	Техкарточки.ГотовоеБлюдо = &ГотовоеБлюдо
	|	И НЕ Техкарточки.ПометкаУдаления
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|";

	ТекстСостава =
	"ВЫБРАТЬ
	|	Состав.Ингредиент КАК Ингредиент,
	|	Состав.НормаБрутто КАК НормаБрутто,
	|	%3 КАК ЕдиницаНормы,
	|	%1 КАК ВесЕдиницы,
	|	%2 КАК ИмяЕдиницы
	|ИЗ
	|	ВыбраннаяКарточка КАК ВыбраннаяКарточка
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Техкарточки.СоставИнгредиентов КАК Состав
	|		ПО ВыбраннаяКарточка.Техкарточка = Состав.Ссылка
	|ГДЕ
	|	Состав.НормаБрутто > 0
	|	И Состав.Ингредиент <> ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка)";

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ГотовоеБлюдо", ГотовоеБлюдо);

	ПолеЕдиницыНормы = ?(ЕстьРеквизитЕдиницаНормы(), "Состав.ЕдиницаНормы", """""");

	// Поле веса определяется по метаданным, а не перебором вариантов:
	// перебор молча давал 0, если реквизита не было, и норма в граммах
	// уходила в списание как штуки.

	Выборка = ВыполнитьЗапросСостава(Запрос, ТекстВыбораКарточки + СтрШаблон(ТекстСостава,
		ВыражениеВесаЕдиницы("Состав.Ингредиент"),
		"Состав.Ингредиент.ЕдиницаИзмерения.Наименование",
		ПолеЕдиницыНормы));

	Если Выборка = Неопределено Тогда
		Выборка = ВыполнитьЗапросСостава(Запрос, ТекстВыбораКарточки + СтрШаблон(ТекстСостава,
			"0",
			"Состав.Ингредиент.ЕдиницаИзмерения.Наименование",
			ПолеЕдиницыНормы));
	КонецЕсли;

	// Не удалось прочитать даже наименование единицы
	Если Выборка = Неопределено Тогда
		Выборка = ВыполнитьЗапросСостава(Запрос,
			ТекстВыбораКарточки + СтрШаблон(ТекстСостава, "0", """""", ПолеЕдиницыНормы));
	КонецЕсли;

	Возврат Выборка;

КонецФункции

// Возвращает выражение запроса, дающее вес одной единицы хранения в килограммах.
//
// Где лежит вес — зависит от конфигурации, поэтому выражение собирается
// по метаданным справочника Номенклатура:
//
//  * есть реквизит Вес                — вес задан прямо в номенклатуре;
//  * есть только ВесЕдиницаИзмерения   — вес задан в упаковке, на которую
//                                        ссылается этот реквизит (УТ 11.5:
//                                        в карточке это «1 шт весит 0,060 кг»);
//  * есть ВесЗнаменатель               — числитель делится на него.
//
// Параметры:
//  Префикс - Строка - путь к номенклатуре в запросе, например «Состав.Ингредиент»
//
// Возвращаемое значение:
//  Строка - выражение запроса; «0», если вес читать неоткуда
//
Функция ВыражениеВесаЕдиницы(Префикс) Экспорт

	Реквизиты = Метаданные.Справочники.Номенклатура.Реквизиты;

	Если Реквизиты.Найти("Вес") <> Неопределено Тогда
		Числитель = Префикс + ".Вес";
	ИначеЕсли Реквизиты.Найти("ВесЕдиницаИзмерения") <> Неопределено Тогда
		Числитель = Префикс + ".ВесЕдиницаИзмерения.Вес";
	Иначе
		Возврат "0";
	КонецЕсли;

	Если Реквизиты.Найти("ВесЗнаменатель") = Неопределено Тогда
		Возврат Числитель;
	КонецЕсли;

	Знаменатель = Префикс + ".ВесЗнаменатель";

	Возврат СтрШаблон("ВЫБОР КОГДА %2 > 0 ТОГДА %1 / %2 ИНАЧЕ %1 КОНЕЦ", Числитель, Знаменатель);

КонецФункции

// Выполняет вариант запроса состава. Возвращает Неопределено, если
// в конфигурации нет какого-то из полей — тогда пробуется следующий вариант.
Функция ВыполнитьЗапросСостава(Запрос, ТекстЗапроса)

	Попытка
		Запрос.Текст = ТекстЗапроса;
		Возврат Запрос.ВыполнитьПакет()[1].Выбрать();
	Исключение
		Возврат Неопределено;
	КонецПопытки;

КонецФункции

// Переводит норму закладки в единицу хранения остатков номенклатуры.
//
// Функция намеренно не обращается к базе: все данные приходят параметрами,
// а получены они одним запросом в ВыбратьСоставТехкарточки.
//
// Единица нормы определяется реквизитом ЕдиницаНормы строки состава.
// Пустое значение трактуется как «граммы» — так вели учёт до появления
// реквизита, и уже заведённые техкарточки продолжают считаться правильно.
//
// Параметры:
//  НормаБрутто  - Число  - норма закладки
//  ВесЕдиницы   - Число  - вес одной единицы хранения в килограммах, 0 если не задан
//  ИмяЕдиницы   - Строка - наименование единицы хранения остатков
//  ЕдиницаНормы - Строка - единица, в которой задана норма: "", "г", "кг", "шт", "л"
//
// Возвращаемое значение:
//  Число - количество в единице хранения остатков
//
Функция ПривестиНормуПоДаннымЕдиницы(НормаБрутто, ВесЕдиницы, ИмяЕдиницы, ЕдиницаНормы = "") Экспорт

	Если НормаБрутто <= 0 Тогда
		Возврат 0;
	КонецЕсли;

	// Норму приводим к килограммам согласно её собственной единице
	НормаВКилограммах = НормаБрутто / 1000;
	НормаШтучная = Ложь;

	ИмяЕдиницыНормы = ВРег(СокрЛП(?(ЕдиницаНормы = Неопределено, "", ЕдиницаНормы)));

	Если ИмяЕдиницыНормы = "КГ" ИЛИ ИмяЕдиницыНормы = "КІЛОГРАМ" ИЛИ ИмяЕдиницыНормы = "КИЛОГРАММ" Тогда
		НормаВКилограммах = НормаБрутто;
	ИначеЕсли ИмяЕдиницыНормы = "Л" ИЛИ ИмяЕдиницыНормы = "ЛІТР" ИЛИ ИмяЕдиницыНормы = "ЛИТР" Тогда
		НормаВКилограммах = НормаБрутто; // плотность не учитываем
	ИначеЕсли ИмяЕдиницыНормы = "ШТ" ИЛИ ИмяЕдиницыНормы = "ШТУКА" ИЛИ ИмяЕдиницыНормы = "ПОРЦ" Тогда
		НормаШтучная = Истина;
	КонецЕсли;

	// Норма задана в штуках — пересчёт по весу не нужен
	Если НормаШтучная Тогда
		Возврат НормаБрутто;
	КонецЕсли;

	// Вес упаковки задан в килограммах: кг нормы → количество упаковок
	Если ЗначениеЗаполнено(ВесЕдиницы) И ВесЕдиницы > 0 Тогда
		Возврат НормаВКилограммах / ВесЕдиницы;
	КонецЕсли;

	Единица = ВРег(СокрЛП(?(ИмяЕдиницы = Неопределено, "", ИмяЕдиницы)));

	// Остатки ведутся в граммах
	Если Единица = "Г" ИЛИ Единица = "ГР" ИЛИ Единица = "ГРАМ" ИЛИ Единица = "ГРАММ" Тогда
		Возврат НормаВКилограммах * 1000;
	КонецЕсли;

	// Штучный учёт без указанного веса: трактуем норму как количество штук
	Если Единица = "ШТ" ИЛИ Единица = "ШТУКА" ИЛИ Единица = "ПОРЦ" ИЛИ Единица = "УП" Тогда
		Возврат НормаБрутто;
	КонецЕсли;

	Возврат НормаВКилограммах;

КонецФункции

#КонецОбласти

#Область ПотребностьИОстатки

// Суммарная потребность в ингредиентах по списку блюд.
//
// Одинаковый ингредиент из разных блюд сворачивается в одну строку: сравнивать
// с остатком нужно общее количество, иначе каждое блюдо по отдельности пройдёт
// проверку, а вместе они склад исчерпают.
//
// Параметры:
//  ТаблицаБлюд - ТаблицаЗначений, ДанныеФормыКоллекция, ТабличнаяЧастьДокумента -
//                строки с колонками Блюдо и КоличествоПорций
//
// Возвращаемое значение:
//  Структура:
//   * Потребность     - ТаблицаЗначений - Ингредиент, ПотребноеКоличество
//   * БлюдаБезСостава - Массив - блюда, для которых не найден состав в техкарточке
//
Функция ПолучитьПотребностьВИнгредиентах(ТаблицаБлюд) Экспорт

	Потребность = Новый ТаблицаЗначений;
	Потребность.Колонки.Добавить("Ингредиент");
	Потребность.Колонки.Добавить("ПотребноеКоличество", Новый ОписаниеТипов("Число"));

	БлюдаБезСостава = Новый Массив;

	Для Каждого СтрокаБлюда Из ТаблицаБлюд Цикл

		Если НЕ ЗначениеЗаполнено(СтрокаБлюда.Блюдо) Или СтрокаБлюда.КоличествоПорций <= 0 Тогда
			Продолжить;
		КонецЕсли;

		СоставИнгредиентов = ПолучитьСоставИнгредиентовБлюда(СтрокаБлюда.Блюдо, СтрокаБлюда.КоличествоПорций);

		Если СоставИнгредиентов.Количество() = 0 Тогда
			Если БлюдаБезСостава.Найти(СтрокаБлюда.Блюдо) = Неопределено Тогда
				БлюдаБезСостава.Добавить(СтрокаБлюда.Блюдо);
			КонецЕсли;
			Продолжить;
		КонецЕсли;

		Для Каждого СтрокаИнгредиент Из СоставИнгредиентов Цикл

			Если НЕ ЗначениеЗаполнено(СтрокаИнгредиент.Ингредиент) Или СтрокаИнгредиент.ОбщееКоличество <= 0 Тогда
				Продолжить;
			КонецЕсли;

			НайденнаяСтрока = Потребность.Найти(СтрокаИнгредиент.Ингредиент, "Ингредиент");
			Если НайденнаяСтрока = Неопределено Тогда
				НайденнаяСтрока = Потребность.Добавить();
				НайденнаяСтрока.Ингредиент = СтрокаИнгредиент.Ингредиент;
			КонецЕсли;

			НайденнаяСтрока.ПотребноеКоличество = НайденнаяСтрока.ПотребноеКоличество + СтрокаИнгредиент.ОбщееКоличество;

		КонецЦикла;

	КонецЦикла;

	Возврат Новый Структура("Потребность, БлюдаБезСостава", Потребность, БлюдаБезСостава);

КонецФункции

// Состав ингредиентов блюда, приведённый к единице хранения остатков.
//
// Параметры:
//  ГотовоеБлюдо     - СправочникСсылка.Номенклатура
//  КоличествоПорций - Число
//
// Возвращаемое значение:
//  ТаблицаЗначений - Ингредиент, КоличествоНаПорцию, ОбщееКоличество
//
Функция ПолучитьСоставИнгредиентовБлюда(ГотовоеБлюдо, КоличествоПорций = 1) Экспорт

	СоставИнгредиентов = Новый ТаблицаЗначений;
	СоставИнгредиентов.Колонки.Добавить("Ингредиент");
	СоставИнгредиентов.Колонки.Добавить("КоличествоНаПорцию", Новый ОписаниеТипов("Число"));
	СоставИнгредиентов.Колонки.Добавить("ОбщееКоличество", Новый ОписаниеТипов("Число"));

	Выборка = ВыбратьСоставТехкарточки(ГотовоеБлюдо);
	Если Выборка = Неопределено Тогда
		Возврат СоставИнгредиентов;
	КонецЕсли;

	Пока Выборка.Следующий() Цикл

		КоличествоНаПорцию = ПривестиНормуПоДаннымЕдиницы(
			Выборка.НормаБрутто, Выборка.ВесЕдиницы, Выборка.ИмяЕдиницы, Выборка.ЕдиницаНормы);

		Если КоличествоНаПорцию <= 0 Тогда
			Продолжить;
		КонецЕсли;

		НоваяСтрока = СоставИнгредиентов.Добавить();
		НоваяСтрока.Ингредиент = Выборка.Ингредиент;
		НоваяСтрока.КоличествоНаПорцию = КоличествоНаПорцию;
		НоваяСтрока.ОбщееКоличество = КоличествоНаПорцию * КоличествоПорций;

	КонецЦикла;

	Возврат СоставИнгредиентов;

КонецФункции

// Определяет, какой регистр накопления хранит остатки товаров и как называется
// его ресурс количества. Проверка идёт по метаданным, без пробных запросов.
//
// Возвращаемое значение:
//  Структура - Регистр, Ресурс. Пустые строки, если подходящий регистр не найден.
//
Функция ОписаниеРегистраОстатков() Экспорт

	Результат = Новый Структура("Регистр, Ресурс", "", "");

	ВариантыРегистров = Новый Массив;
	ВариантыРегистров.Добавить("ТоварыНаСкладах");
	ВариантыРегистров.Добавить("ОстаткиТоваров");
	ВариантыРегистров.Добавить("ТоварныеЗапасы");
	ВариантыРегистров.Добавить("Запасы");

	ВариантыРесурсов = Новый Массив;
	ВариантыРесурсов.Добавить("ВНаличии");
	ВариантыРесурсов.Добавить("Количество");

	Для Каждого ИмяРегистра Из ВариантыРегистров Цикл

		РегистрМетаданных = Метаданные.РегистрыНакопления.Найти(ИмяРегистра);
		Если РегистрМетаданных = Неопределено Тогда
			Продолжить;
		КонецЕсли;

		Если РегистрМетаданных.ВидРегистра <> Метаданные.СвойстваОбъектов.ВидРегистраНакопления.Остатки Тогда
			Продолжить;
		КонецЕсли;

		Если РегистрМетаданных.Измерения.Найти("Номенклатура") = Неопределено
			Или РегистрМетаданных.Измерения.Найти("Склад") = Неопределено Тогда
			Продолжить;
		КонецЕсли;

		Для Каждого ИмяРесурса Из ВариантыРесурсов Цикл
			Если РегистрМетаданных.Ресурсы.Найти(ИмяРесурса) <> Неопределено Тогда
				Результат.Регистр = ИмяРегистра;
				Результат.Ресурс = ИмяРесурса;
				Возврат Результат;
			КонецЕсли;
		КонецЦикла;

	КонецЦикла;

	Возврат Результат;

КонецФункции

// Остатки сразу по списку номенклатуры одним запросом.
//
// Параметры:
//  МассивНоменклатуры - Массив
//  Склад              - СправочникСсылка.Склады
//  НаДату             - Дата - момент, на который нужны остатки.
//                              Пусто — текущие остатки.
//
// Возвращаемое значение:
//  Соответствие - ключ: номенклатура, значение: Число.
//                 Отсутствие ключа означает нулевой остаток.
//
Функция ПолучитьОстаткиТоваровНаСкладе(МассивНоменклатуры, Склад, НаДату = Неопределено) Экспорт

	Остатки = Новый Соответствие;

	Если МассивНоменклатуры.Количество() = 0 Или НЕ ЗначениеЗаполнено(Склад) Тогда
		Возврат Остатки;
	КонецЕсли;

	ОписаниеРегистра = ОписаниеРегистраОстатков();
	Если ПустаяСтрока(ОписаниеРегистра.Регистр) Тогда
		Возврат Остатки;
	КонецЕсли;

	УстановитьПривилегированныйРежим(Истина);

	Попытка
		Запрос = Новый Запрос;
		Запрос.Текст = СтрШаблон(
		"ВЫБРАТЬ
		|	ОстаткиТоваров.Номенклатура КАК Номенклатура,
		|	СУММА(ЕСТЬNULL(ОстаткиТоваров.%2Остаток, 0)) КАК Остаток
		|ИЗ
		|	РегистрНакопления.%1.Остатки(&НаДату, Номенклатура В (&СписокНоменклатуры) И Склад = &Склад) КАК ОстаткиТоваров
		|
		|СГРУППИРОВАТЬ ПО
		|	ОстаткиТоваров.Номенклатура",
		ОписаниеРегистра.Регистр, ОписаниеРегистра.Ресурс);

		Запрос.УстановитьПараметр("НаДату", ?(ЗначениеЗаполнено(НаДату), НаДату, Неопределено));
		Запрос.УстановитьПараметр("СписокНоменклатуры", МассивНоменклатуры);
		Запрос.УстановитьПараметр("Склад", Склад);

		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			Остатки.Вставить(Выборка.Номенклатура, Выборка.Остаток);
		КонецЦикла;
	Исключение
		ЗаписьЖурналаРегистрации("Остатки ингредиентов",
			УровеньЖурналаРегистрации.Ошибка, , ,
			ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

	Возврат Остатки;

КонецФункции

// Проверяет, хватает ли ингредиентов на складе для приготовления.
//
// Единая точка для кнопки на форме и для контроля при проведении: раньше
// проверка жила только в модуле формы, поэтому программная запись документа
// или ввод на основании списывали сырьё в минус без единого сообщения.
//
// Параметры:
//  ТаблицаБлюд - строки с колонками Блюдо и КоличествоПорций
//  СкладСырья  - СправочникСсылка.Склады
//  НаДату      - Дата - момент расчёта остатков. Пусто — текущие.
//
// Возвращаемое значение:
//  Структура:
//   * ХватаетВсего    - Булево
//   * Строки          - ТаблицаЗначений - Ингредиент, Требуется, Остаток, Недостаток, Хватает
//   * БлюдаБезСостава - Массив
//
Функция ПроверитьНаличиеИнгредиентов(ТаблицаБлюд, СкладСырья, НаДату = Неопределено) Экспорт

	Строки = Новый ТаблицаЗначений;
	Строки.Колонки.Добавить("Ингредиент");
	Строки.Колонки.Добавить("Требуется", Новый ОписаниеТипов("Число"));
	Строки.Колонки.Добавить("Остаток", Новый ОписаниеТипов("Число"));
	Строки.Колонки.Добавить("Недостаток", Новый ОписаниеТипов("Число"));
	Строки.Колонки.Добавить("Хватает", Новый ОписаниеТипов("Булево"));

	ДанныеПотребности = ПолучитьПотребностьВИнгредиентах(ТаблицаБлюд);

	Результат = Новый Структура("ХватаетВсего, Строки, БлюдаБезСостава",
		Истина, Строки, ДанныеПотребности.БлюдаБезСостава);

	Если ДанныеПотребности.БлюдаБезСостава.Количество() > 0 Тогда
		Результат.ХватаетВсего = Ложь;
	КонецЕсли;

	Если ДанныеПотребности.Потребность.Количество() = 0 Тогда
		Возврат Результат;
	КонецЕсли;

	Остатки = ПолучитьОстаткиТоваровНаСкладе(
		ДанныеПотребности.Потребность.ВыгрузитьКолонку("Ингредиент"), СкладСырья, НаДату);

	Для Каждого СтрокаПотребности Из ДанныеПотребности.Потребность Цикл

		Остаток = Остатки.Получить(СтрокаПотребности.Ингредиент);
		Если Остаток = Неопределено Тогда
			Остаток = 0;
		КонецЕсли;

		НоваяСтрока = Строки.Добавить();
		НоваяСтрока.Ингредиент = СтрокаПотребности.Ингредиент;
		НоваяСтрока.Требуется = СтрокаПотребности.ПотребноеКоличество;
		НоваяСтрока.Остаток = Остаток;
		НоваяСтрока.Хватает = Остаток >= СтрокаПотребности.ПотребноеКоличество;
		НоваяСтрока.Недостаток = ?(НоваяСтрока.Хватает, 0, СтрокаПотребности.ПотребноеКоличество - Остаток);

		Если НЕ НоваяСтрока.Хватает Тогда
			Результат.ХватаетВсего = Ложь;
		КонецЕсли;

	КонецЦикла;

	Возврат Результат;

КонецФункции

#КонецОбласти

#Область РегламентныеОперации

// Пересчитывает себестоимость техкарточек, помеченных как требующие пересчёта.
//
// Обработчик регламентного задания «Пересчёт себестоимости».
//
// Зачем: ПриЗаписи цены синхронно перебирал все техкарточки с этим
// ингредиентом. При обновлении прайса на сотню позиций пользователь получал
// долгую блокирующую операцию прямо в момент сохранения. Теперь запись цены
// только регистрирует ингредиент в очереди, а тяжёлая работа уходит в фон.
//
// Очередь — РегистрСведений.ОчередьПересчетаСебестоимости (измерение
// Ингредиент). Пока регистр не создан, процедура сообщает об этом и выходит:
// работоспособность подсистемы от неё не зависит.
//
Процедура ПересчитатьСебестоимостьПоОчереди() Экспорт

	Если НЕ ЕстьОчередьПересчета() Тогда
		ЗаписьЖурналаРегистрации("Пересчёт себестоимости",
			УровеньЖурналаРегистрации.Информация, , ,
			"Регистр ОчередьПересчетаСебестоимости не создан — пересчёт по очереди пропущен");
		Возврат;
	КонецЕсли;

	УстановитьПривилегированныйРежим(Истина);

	Запрос = Новый Запрос(
		"ВЫБРАТЬ
		|	Очередь.Ингредиент КАК Ингредиент
		|ИЗ
		|	РегистрСведений.ОчередьПересчетаСебестоимости КАК Очередь");

	Выборка = Запрос.Выполнить().Выбрать();

	Обработано = 0;

	Пока Выборка.Следующий() Цикл

		Попытка
			ОбновитьЦеныПоИнгредиенту(Выборка.Ингредиент);

			// Из очереди убираем только после успешного пересчёта:
			// иначе сбой потерял бы задание
			МенеджерЗаписи = РегистрыСведений.ОчередьПересчетаСебестоимости.СоздатьМенеджерЗаписи();
			МенеджерЗаписи.Ингредиент = Выборка.Ингредиент;
			МенеджерЗаписи.Удалить();

			Обработано = Обработано + 1;

		Исключение
			ЗаписьЖурналаРегистрации("Пересчёт себестоимости",
				УровеньЖурналаРегистрации.Ошибка, , Выборка.Ингредиент,
				ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		КонецПопытки;

	КонецЦикла;

	Если Обработано > 0 Тогда
		ЗаписьЖурналаРегистрации("Пересчёт себестоимости",
			УровеньЖурналаРегистрации.Информация, , ,
			"Пересчитано ингредиентов: " + Формат(Обработано, "ЧДЦ=0; ЧГ=0"));
	КонецЕсли;

КонецПроцедуры

// Ставит ингредиент в очередь на пересчёт себестоимости.
//
// Вызывается из ПриЗаписи элемента ЦеныНаИнгредиенты.
//
// Возвращаемое значение:
//  Булево - Истина, если ингредиент поставлен в очередь;
//           Ложь, если очереди нет и пересчёт нужно делать сразу
//
Функция ПоставитьВОчередьПересчета(Ингредиент) Экспорт

	Если НЕ ЗначениеЗаполнено(Ингредиент) Или НЕ ЕстьОчередьПересчета() Тогда
		Возврат Ложь;
	КонецЕсли;

	УстановитьПривилегированныйРежим(Истина);

	МенеджерЗаписи = РегистрыСведений.ОчередьПересчетаСебестоимости.СоздатьМенеджерЗаписи();
	МенеджерЗаписи.Ингредиент = Ингредиент;
	МенеджерЗаписи.Записать(Истина);

	Возврат Истина;

КонецФункции

// Сверяет сохранённую себестоимость техкарточек с рассчитанной заново.
//
// Обработчик регламентного задания «Сверка себестоимости».
// Ничего не записывает — только пишет расхождения в журнал регистрации.
// Себестоимость хранится в реквизите, поэтому со временем может разойтись
// с фактическими ценами: регламентная сверка ловит это раньше пользователя.
//
// Возвращаемое значение:
//  Число - количество техкарточек с расхождением
//
Функция СверитьСебестоимость() Экспорт

	УстановитьПривилегированныйРежим(Истина);

	Запрос = Новый Запрос(
		"ВЫБРАТЬ
		|	Техкарточки.Ссылка КАК Ссылка,
		|	Техкарточки.СебестоимостьПорции КАК СебестоимостьПорции
		|ИЗ
		|	Справочник.Техкарточки КАК Техкарточки
		|ГДЕ
		|	НЕ Техкарточки.ПометкаУдаления");

	Выборка = Запрос.Выполнить().Выбрать();

	Расхождений = 0;

	Пока Выборка.Следующий() Цикл

		Расчетная = РассчитатьСебестоимостьТехКарточки(Выборка.Ссылка);

		Если Окр(Расчетная, 2) = Окр(Выборка.СебестоимостьПорции, 2) Тогда
			Продолжить;
		КонецЕсли;

		Расхождений = Расхождений + 1;

		ЗаписьЖурналаРегистрации("Сверка себестоимости",
			УровеньЖурналаРегистрации.Предупреждение,
			Метаданные.Справочники.Техкарточки,
			Выборка.Ссылка,
			СтрШаблон("Сохранено %1, рассчитано %2",
				Формат(Выборка.СебестоимостьПорции, "ЧДЦ=2"),
				Формат(Расчетная, "ЧДЦ=2")));

	КонецЦикла;

	ЗаписьЖурналаРегистрации("Сверка себестоимости",
		УровеньЖурналаРегистрации.Информация, , ,
		"Расхождений найдено: " + Формат(Расхождений, "ЧДЦ=0; ЧГ=0"));

	Возврат Расхождений;

КонецФункции

// Фиксирует себестоимость техкарточки в истории.
//
// Вызывается из ПриЗаписи техкарточки. История нужна, чтобы отвечать
// на вопрос «почему блюдо подорожало»: сейчас изменения цен видны
// в ЦеныНаИнгредиенты.ИсторияЦен, а итоговая себестоимость нигде не хранится.
//
// Пишет в РегистрСведений.ИсторияСебестоимости (периодический, в пределах дня,
// измерение Техкарточка, ресурс СебестоимостьПорции). Пока регистра нет —
// молча ничего не делает.
//
Процедура ЗафиксироватьСебестоимостьВИстории(ТехКарточкаСсылка, СебестоимостьПорции) Экспорт

	Если НЕ ЗначениеЗаполнено(ТехКарточкаСсылка) Или НЕ ЕстьИсториюСебестоимости() Тогда
		Возврат;
	КонецЕсли;

	УстановитьПривилегированныйРежим(Истина);

	Попытка
		МенеджерЗаписи = РегистрыСведений.ИсторияСебестоимости.СоздатьМенеджерЗаписи();
		МенеджерЗаписи.Период = ТекущаяДатаСеанса();
		МенеджерЗаписи.Техкарточка = ТехКарточкаСсылка;
		МенеджерЗаписи.СебестоимостьПорции = СебестоимостьПорции;
		МенеджерЗаписи.Записать(Истина);
	Исключение
		// История — вспомогательная функция: её сбой не должен срывать запись техкарточки
		ЗаписьЖурналаРегистрации("История себестоимости",
			УровеньЖурналаРегистрации.Ошибка, , ТехКарточкаСсылка,
			ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Является ли единица измерения весовой.
//
// Для весовых единиц пересчёт через вес номенклатуры не нужен: цена
// за килограмм уже приведена к нужному виду, а цена за грамм или тонну
// пересчитывается по наименованию.
Функция ЭтоВесоваяЕдиница(ЕдиницаИзмерения)

	Наименование = "";
	Попытка
		Наименование = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ЕдиницаИзмерения, "Наименование");
	Исключение
		Возврат Ложь;
	КонецПопытки;

	ИмяЕдиницы = ВРег(СокрЛП(Наименование));

	Возврат ИмяЕдиницы = "КГ" ИЛИ ИмяЕдиницы = "КІЛОГРАМ" ИЛИ ИмяЕдиницы = "КИЛОГРАММ"
		ИЛИ ИмяЕдиницы = "Г" ИЛИ ИмяЕдиницы = "ГР" ИЛИ ИмяЕдиницы = "ГРАМ" ИЛИ ИмяЕдиницы = "ГРАММ"
		ИЛИ ИмяЕдиницы = "Т" ИЛИ ИмяЕдиницы = "ТОННА";

КонецФункции

// Создан ли регистр очереди пересчёта.
Функция ЕстьОчередьПересчета()

	Возврат Метаданные.РегистрыСведений.Найти("ОчередьПересчетаСебестоимости") <> Неопределено;

КонецФункции

// Создан ли регистр истории себестоимости.
Функция ЕстьИсториюСебестоимости()

	Возврат Метаданные.РегистрыСведений.Найти("ИсторияСебестоимости") <> Неопределено;

КонецФункции

// Есть ли в составе ингредиентов реквизит ЕдиницаНормы.
//
// Реквизит необязателен: пока его не добавили, норма считается заданной
// в граммах — как было до его появления.
Функция ЕстьРеквизитЕдиницаНормы()

	Возврат Метаданные.Справочники.Техкарточки.ТабличныеЧасти.СоставИнгредиентов
		.Реквизиты.Найти("ЕдиницаНормы") <> Неопределено;

КонецФункции

// Достаёт цену из пакета, полученного функцией ПолучитьЦеныИнгредиентов.
//
// Приоритет у явно указанной в строке ссылки на элемент ЦеныНаИнгредиенты;
// если её нет — берётся активная цена по ингредиенту.
//
// Параметры:
//  Цены            - Структура - результат ПолучитьЦеныИнгредиентов
//  Ингредиент      - СправочникСсылка.Номенклатура
//  ЦенаИнгредиента - СправочникСсылка.ЦеныНаИнгредиенты
//
// Возвращаемое значение:
//  Число - Цена за килограмм, 0 если цена не найдена
//
Функция ЦенаИзКеша(Цены, Ингредиент, ЦенаИнгредиента)

	Если ЗначениеЗаполнено(ЦенаИнгредиента) Тогда
		Найденная = Цены.ПоСсылке.Получить(ЦенаИнгредиента);
		Если Найденная <> Неопределено Тогда
			Возврат Найденная;
		КонецЕсли;
	КонецЕсли;

	Если ЗначениеЗаполнено(Ингредиент) Тогда
		Найденная = Цены.ПоИнгредиенту.Получить(Ингредиент);
		Если Найденная <> Неопределено Тогда
			Возврат Найденная;
		КонецЕсли;
	КонецЕсли;

	Возврат 0;

КонецФункции

// Рассчитать общую себестоимость порции
//
// Параметры:
//  ТехКарточкаОбъект - СправочникОбъект.Техкарточки
//
// Возвращаемое значение:
//  Число - Общая себестоимость порции
//
Функция РассчитатьОбщуюСебестоимость(ТехКарточкаОбъект)

	ОбщаяСебестоимость = 0;

	Для Каждого СтрокаИнгредиент Из ТехКарточкаОбъект.СоставИнгредиентов Цикл
		ОбщаяСебестоимость = ОбщаяСебестоимость + СтрокаИнгредиент.СуммаСтоимости;
	КонецЦикла;

	Возврат ОбщаяСебестоимость;

КонецФункции

// Привести цену к килограммам
//
// Параметры:
//  ЦенаЗаЕдиницу - Число - Цена за единицу измерения
//  ЕдиницаИзмерения - СправочникСсылка.УпаковкиЕдиницыИзмерения - Единица измерения
//
// Возвращаемое значение:
//  Число - Цена за килограмм
//
Функция ПривестиЦенуККилограммам(ЦенаЗаЕдиницу, ЕдиницаИзмерения, ВесНоменклатуры = 0)

	Если НЕ ЗначениеЗаполнено(ЕдиницаИзмерения) Тогда
		// Если единица измерения не указана, считаем что цена за кг
		Возврат ЦенаЗаЕдиницу;
	КонецЕсли;

	// Коэффициент показывает, сколько единиц измерения содержится в одном килограмме
	КоличествоЕдиницВКилограмме = ПолучитьКоэффициентПереводаВКилограммы(ЕдиницаИзмерения, ВесНоменклатуры);

	Если КоличествоЕдиницВКилограмме = 0 Тогда
		Возврат ЦенаЗаЕдиницу; // Возвращаем исходную цену, если не можем перевести
	КонецЕсли;

	// Цена за кг = цена за единицу * количество единиц в килограмме.
	// Для грамма: 1 кг = 1000 г, цена за грамм 0,05 -> 0,05 * 1000 = 50 грн/кг.
	// Для тонны:  1 кг = 0,001 т, цена за тонну 50000 -> 50000 * 0,001 = 50 грн/кг.
	Возврат ЦенаЗаЕдиницу * КоличествоЕдиницВКилограмме;

КонецФункции

// Получить коэффициент перевода единицы измерения в килограммы
//
// Реквизит ЦеныНаИнгредиенты.ЕдиницаИзмерения имеет тип
// СправочникСсылка.УпаковкиЕдиницыИзмерения (справочник упаковок УТ 11),
// а не КлассификаторЕдиницИзмерения. Реквизита "Код" у него нет —
// единица распознаётся по наименованию, а вес упаковки, если он заполнен,
// имеет приоритет над разбором наименования.
//
// Параметры:
//  ЕдиницаИзмерения - СправочникСсылка.УпаковкиЕдиницыИзмерения
//
// Возвращаемое значение:
//  Число - Сколько указанных единиц содержится в одном килограмме
//
Функция ПолучитьКоэффициентПереводаВКилограммы(ЕдиницаИзмерения, ВесНоменклатуры = 0)

	Если НЕ ЗначениеЗаполнено(ЕдиницаИзмерения) Тогда
		Возврат 1;
	КонецЕсли;

	// Состав реквизитов упаковки отличается между версиями УТ,
	// поэтому читаем защищённо
	ВесУпаковки = 0;
	Попытка
		ВесУпаковки = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ЕдиницаИзмерения, "Вес");
	Исключение
		ВесУпаковки = 0;
	КонецПопытки;

	// Вес упаковки задан в килограммах: 1 кг = 1 / ВесУпаковки таких упаковок
	Если ЗначениеЗаполнено(ВесУпаковки) И ВесУпаковки > 0 Тогда
		Возврат 1 / ВесУпаковки;
	КонецЕсли;

	// В УТ 11 вес хранится не в упаковке, а в самой номенклатуре.
	// Если цена задана за штучную единицу, а вес одной штуки известен —
	// пересчитываем через него: цена за булку 5 грн при весе 0,06 кг
	// означает 5 / 0,06 = 83,33 грн за килограмм.
	Если ЗначениеЗаполнено(ВесНоменклатуры) И ВесНоменклатуры > 0
		И НЕ ЭтоВесоваяЕдиница(ЕдиницаИзмерения) Тогда
		Возврат 1 / ВесНоменклатуры;
	КонецЕсли;

	Наименование = "";
	Попытка
		Наименование = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ЕдиницаИзмерения, "Наименование");
	Исключение
		Наименование = "";
	КонецПопытки;

	ИмяЕдиницы = ВРег(СокрЛП(Наименование));

	Если ИмяЕдиницы = "КГ" ИЛИ ИмяЕдиницы = "КІЛОГРАМ" ИЛИ ИмяЕдиницы = "КИЛОГРАММ" Тогда
		Возврат 1;
	ИначеЕсли ИмяЕдиницы = "Г" ИЛИ ИмяЕдиницы = "ГР" ИЛИ ИмяЕдиницы = "ГРАМ" ИЛИ ИмяЕдиницы = "ГРАММ" Тогда
		Возврат 1000;
	ИначеЕсли ИмяЕдиницы = "Т" ИЛИ ИмяЕдиницы = "ТОННА" Тогда
		Возврат 0.001;
	ИначеЕсли ИмяЕдиницы = "Л" ИЛИ ИмяЕдиницы = "ЛІТР" ИЛИ ИмяЕдиницы = "ЛИТР" Тогда
		// Плотность не учитываем: для воды 1 л ≈ 1 кг.
		// Для масла и сиропов даёт погрешность — задайте вес упаковки
		Возврат 1;
	Иначе
		// Для неизвестных единиц считаем, что цена уже за килограмм
		Возврат 1;
	КонецЕсли;

КонецФункции

#КонецОбласти
////////////////////////////////////////////////////////////////////////////////
// МОДУЛЬ ОБЪЕКТА СПРАВОЧНИКА "ТЕХКАРТОЧКИ"
//
// ВАЖНО: это модуль ОБЪЕКТА, а не модуль менеджера.
// События ОбработкаЗаполнения, ПередЗаписью, ПриЗаписи вызываются платформой
// только в модуле объекта. В модуле менеджера справочника таких обработчиков
// нет — размещённый там код молча не выполняется.
//
// Сигнатуры обработчиков модуля объекта не содержат параметр "Объект":
// сам объект доступен как ЭтотОбъект, а его реквизиты — напрямую по имени.
////////////////////////////////////////////////////////////////////////////////

#Область ОбработчикиСобытий

// Вызывается при создании нового элемента, в том числе при вводе на основании.
//
// Параметры:
//  ДанныеЗаполнения     - Произвольный - Данные для заполнения
//  СтандартнаяОбработка - Булево - Признак выполнения стандартной обработки события
//
Процедура ОбработкаЗаполнения(ДанныеЗаполнения, СтандартнаяОбработка)

	// Значения по умолчанию для новой техкарточки
	Если ВыходПорции = 0 Тогда
		ВыходПорции = 100;
	КонецЕсли;

	Если ВремяПриготовления = 0 Тогда
		ВремяПриготовления = 30;
	КонецЕсли;

	// Подтягиваем актуальные цены, если состав уже заполнен данными заполнения
	Если СоставИнгредиентов.Количество() > 0 Тогда
		РасчетСебестоимостиМодуль.ОбновитьЦеныВТехКарточке(ЭтотОбъект);
	КонецЕсли;

КонецПроцедуры

// Вызывается перед записью объекта в базу.
//
// Параметры:
//  Отказ - Булево - Признак отказа от записи
//
Процедура ПередЗаписью(Отказ)

	// Обмен данными — это загрузка из другого узла, пересчитывать не нужно
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;

	// Держим норму нетто согласованной с нормой брутто и процентом отходов
	Для Каждого СтрокаИнгредиент Из СоставИнгредиентов Цикл

		Если СтрокаИнгредиент.НормаБрутто > 0 Тогда
			СтрокаИнгредиент.НормаНетто = СтрокаИнгредиент.НормаБрутто
				* (100 - СтрокаИнгредиент.ПроцентОтходов) / 100;
		Иначе
			СтрокаИнгредиент.НормаНетто = 0;
		КонецЕсли;

	КонецЦикла;

	// Обновляем цены и пересчитываем себестоимость перед записью
	РасчетСебестоимостиМодуль.ОбновитьЦеныВТехКарточке(ЭтотОбъект);

КонецПроцедуры

// Вызывается после успешной записи объекта.
//
// Параметры:
//  Отказ - Булево - Признак отказа от записи
//
Процедура ПриЗаписи(Отказ)

	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;

	// Фиксируем себестоимость в истории — по ней потом видно,
	// когда и на сколько изменилась стоимость блюда
	РасчетСебестоимостиМодуль.ЗафиксироватьСебестоимостьВИстории(Ссылка, СебестоимостьПорции);

КонецПроцедуры

#КонецОбласти

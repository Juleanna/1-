////////////////////////////////////////////////////////////////////////////////
// МОДУЛЬ ОБЪЕКТА СПРАВОЧНИКА "ЦЕНЫ НА ИНГРЕДИЕНТЫ"
//
// ВАЖНО: это модуль ОБЪЕКТА, а не модуль менеджера.
// События ПередЗаписью и ПриЗаписи вызываются платформой только в модуле
// объекта; в модуле менеджера справочника таких обработчиков нет.
//
// Сигнатуры обработчиков модуля объекта не содержат параметр "Объект":
// сам объект доступен как ЭтотОбъект, реквизиты — напрямую по имени.
////////////////////////////////////////////////////////////////////////////////

#Область ОбработчикиСобытий

// Вызывается перед записью элемента справочника.
//
// Параметры:
//  Отказ - Булево - Признак отказа от записи
//
Процедура ПередЗаписью(Отказ)

	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;

	// При изменении цены запоминаем старое значение в истории
	Если НЕ ЭтоНовый() Тогда

		СтараяЦена = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Ссылка, "ЦенаЗаЕдиницу");

		Если СтараяЦена <> ЦенаЗаЕдиницу Тогда

			НоваяСтрокаИстории = ИсторияЦен.Добавить();
			НоваяСтрокаИстории.ДатаИзменения = ТекущаяДатаСеанса();
			НоваяСтрокаИстории.СтараяЦена = СтараяЦена;
			НоваяСтрокаИстории.НоваяЦена = ЦенаЗаЕдиницу;
			НоваяСтрокаИстории.ПричинаИзменения = "Изменение цены";

			// Дата установки цены должна отражать момент последнего изменения
			ДатаУстановкиЦены = ТекущаяДатаСеанса();

		КонецЕсли;

	КонецЕсли;

	// Для нового элемента проставляем дату установки цены
	Если НЕ ЗначениеЗаполнено(ДатаУстановкиЦены) Тогда
		ДатаУстановкиЦены = ТекущаяДатаСеанса();
	КонецЕсли;

КонецПроцедуры

// Вызывается после успешной записи элемента справочника.
//
// Параметры:
//  Отказ - Булево - Признак отказа от записи
//
Процедура ПриЗаписи(Отказ)

	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;

	// Пересчитываем техкарточки только для активных цен: запись неактивной
	// цены на себестоимость не влияет
	Если НЕ ЗначениеЗаполнено(Ингредиент) Или НЕ Активность Тогда
		Возврат;
	КонецЕсли;

	// Сначала пробуем поставить в очередь: перебор сотен техкарточек прямо
	// в транзакции записи цены превращает сохранение прайса в долгую
	// блокирующую операцию. Тяжёлую работу выполнит регламентное задание.
	//
	// Если регистр очереди ещё не создан, пересчитываем сразу — как раньше,
	// чтобы себестоимость не осталась устаревшей.
	Если НЕ РасчетСебестоимостиМодуль.ПоставитьВОчередьПересчета(Ингредиент) Тогда
		РасчетСебестоимостиМодуль.ОбновитьЦеныПоИнгредиенту(Ингредиент);
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

////////////////////////////////////////////////////////////////////////////////
// МОДУЛЬ ФОРМЫ ОТЧЁТА «АНАЛИЗ СЕБЕСТОИМОСТИ С ДИАГРАММОЙ»
//
// Отчёт собран на обычной форме, схема компоновки данных не используется.
// Данные берутся из Обработки.АнализСебестоимостиБлюд.
//
// Реквизиты хранятся у САМОГО ОТЧЁТА, поэтому модуль обращается к ним
// через «Отчет.»: Отчет.НачалоПериода, Отчет.РезультатАнализа и так далее.
// На форме они появляются внутри автоматического реквизита «Отчет».
//
// Что должно быть у отчёта (окно редактирования → «Данные»):
//   * реквизиты        НачалоПериода, КонецПериода — Дата
//                      Склад — СправочникСсылка.Склады
//                      ДиаграммаСебестоимости, ДиаграммаКруговая,
//                      ДиаграммаПорции, ДиаграммаТренд — Диаграмма
//   * табличная часть  РезультатАнализа с колонками Рецепт, ГотовоеБлюдо,
//                      КоличествоПорций, СуммарнаяСебестоимость,
//                      СебестоимостьПорции, КоличествоИнгредиентов
//
// Что должно быть на форме:
//   * поля периода и склада, четыре поля диаграмм, таблица РезультатАнализа
//   * команды Сформировать, ОбновитьДиаграммы
//
// Привязки: форма → ПриОткрытии; таблица РезультатАнализа → событие Выбор;
// у обеих команд заполнено свойство «Действие».
//
// Порядок создания — пункт 4.7 инструкции ОНОВЛЕННЯ.md.
////////////////////////////////////////////////////////////////////////////////

#Область ОбработчикиСобытийФормы

&НаКлиенте
Процедура ПриОткрытии(Отказ)

    УстановитьПериодПоУмолчанию();

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура Сформировать(Команда)

    СформироватьОтчетНаСервере();
    СоздатьДиаграммыАнализа();

КонецПроцедуры

&НаКлиенте
Процедура ОбновитьДиаграммы(Команда)

    СоздатьДиаграммыАнализа();

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура УстановитьПериодПоУмолчанию()

    Отчет.НачалоПериода = НачалоМесяца(ТекущаяДата());
    Отчет.КонецПериода = КонецДня(ТекущаяДата());

КонецПроцедуры

&НаСервере
Процедура СформироватьОтчетНаСервере()

    ПараметрыОтчета = Новый Структура;
    ПараметрыОтчета.Вставить("НачалоПериода", Отчет.НачалоПериода);
    ПараметрыОтчета.Вставить("КонецПериода", Отчет.КонецПериода);
    ПараметрыОтчета.Вставить("Склад", Отчет.Склад);

    // Получаем данные для анализа
    ОбработкаАнализ = Обработки.АнализСебестоимостиБлюд.Создать();
    ДанныеАнализа = ОбработкаАнализ.ПолучитьДанныеДляАнализа(ПараметрыОтчета);

    // Заполняем табличную часть отчёта
    Отчет.РезультатАнализа.Загрузить(ДанныеАнализа);

КонецПроцедуры

// Возвращает данные отчёта, отсортированные по указанной колонке.
//
// У таблицы формы (ДанныеФормыКоллекция) нет методов Скопировать() и Сортировать() —
// они есть только у ТаблицыЗначений. Поэтому сортировка выполняется на сервере,
// а на клиент возвращается массив структур.
//
// Параметры:
//  ПорядокСортировки - Строка - например "СуммарнаяСебестоимость УБЫВ"
//  КоличествоСтрок   - Число  - 0 означает "все строки"
//
// Возвращаемое значение:
//  Массив из Структура - ГотовоеБлюдо, СебестоимостьПорции, СуммарнаяСебестоимость,
//                        КоличествоПорций, КоличествоИнгредиентов
//
&НаСервере
Функция ОтсортированныеДанныеАнализа(ПорядокСортировки, КоличествоСтрок = 0)

    // РеквизитФормыВЗначение принимает имя реквизита формы целиком, поэтому
    // берём объект отчёта, а табличную часть выгружаем уже из него
    Таблица = РеквизитФормыВЗначение("Отчет").РезультатАнализа.Выгрузить();
    Таблица.Сортировать(ПорядокСортировки);

    Результат = Новый Массив;

    Для Каждого СтрокаТаблицы Из Таблица Цикл

        Если КоличествоСтрок > 0 И Результат.Количество() >= КоличествоСтрок Тогда
            Прервать;
        КонецЕсли;

        Элемент = Новый Структура(
            "ГотовоеБлюдо, СебестоимостьПорции, СуммарнаяСебестоимость, КоличествоПорций, КоличествоИнгредиентов",
            Строка(СтрокаТаблицы.ГотовоеБлюдо),
            СтрокаТаблицы.СебестоимостьПорции,
            СтрокаТаблицы.СуммарнаяСебестоимость,
            СтрокаТаблицы.КоличествоПорций,
            СтрокаТаблицы.КоличествоИнгредиентов);

        Результат.Добавить(Элемент);

    КонецЦикла;

    Возврат Результат;

КонецФункции

&НаКлиенте
Процедура СоздатьДиаграммыАнализа()

    СоздатьДиаграммуСебестоимостиПоБлюдам();
    СоздатьДиаграммуКруговуюСтруктурыЗатрат();
    СоздатьДиаграммуГистограммуПорций();
    СоздатьДиаграммуТрендаСебестоимости();

КонецПроцедуры

&НаКлиенте
Процедура СоздатьДиаграммуСебестоимостиПоБлюдам()

    // Создаем диаграмму типа "Гистограмма"
    Отчет.ДиаграммаСебестоимости.Очистить();
    Отчет.ДиаграммаСебестоимости.ТипДиаграммы = ТипДиаграммы.Гистограмма;
    Отчет.ДиаграммаСебестоимости.Заголовок = "Анализ себестоимости по блюдам";

    // Настраиваем оси
    Отчет.ДиаграммаСебестоимости.ОсьX.Заголовок = "Блюда";
    Отчет.ДиаграммаСебестоимости.ОсьY.Заголовок = "Себестоимость (грн)";

    // Добавляем серии данных
    СерияСебестоимостьПорции = Отчет.ДиаграммаСебестоимости.УстановитьСерию("Себестоимость порции");
    СерияСуммарнаяСебестоимость = Отчет.ДиаграммаСебестоимости.УстановитьСерию("Общая себестоимость");

    СерияСебестоимостьПорции.Цвет = WebЦвета.СинийСтальной;
    СерияСуммарнаяСебестоимость.Цвет = WebЦвета.КрасныйТемный;

    // Заполняем данными
    Для Каждого СтрокаДанных Из Отчет.РезультатАнализа Цикл

        Точка = Отчет.ДиаграммаСебестоимости.УстановитьТочку(Строка(СтрокаДанных.ГотовоеБлюдо));
        Точка.УстановитьЗначение(СерияСебестоимостьПорции, СтрокаДанных.СебестоимостьПорции);
        Точка.УстановитьЗначение(СерияСуммарнаяСебестоимость, СтрокаДанных.СуммарнаяСебестоимость);

    КонецЦикла;

КонецПроцедуры

&НаКлиенте
Процедура СоздатьДиаграммуКруговуюСтруктурыЗатрат()

    // Создаем круговую диаграмму для анализа структуры затрат
    Отчет.ДиаграммаКруговая.Очистить();
    Отчет.ДиаграммаКруговая.ТипДиаграммы = ТипДиаграммы.Круговая;
    Отчет.ДиаграммаКруговая.Заголовок = "Структура затрат по блюдам";

    // Добавляем серию
    СерияЗатраты = Отчет.ДиаграммаКруговая.УстановитьСерию("Затраты");

    // Определяем цвета для секторов
    МассивЦветов = Новый Массив;
    МассивЦветов.Добавить(WebЦвета.Зеленый);
    МассивЦветов.Добавить(WebЦвета.Синий);
    МассивЦветов.Добавить(WebЦвета.Красный);
    МассивЦветов.Добавить(WebЦвета.Оранжевый);
    МассивЦветов.Добавить(WebЦвета.Фиолетовый);
    МассивЦветов.Добавить(WebЦвета.Коричневый);

    ИндексЦвета = 0;

    // Заполняем данными (берем топ-6 блюд по затратам). Сортировка на сервере:
    // у таблицы формы нет методов Скопировать() и Сортировать()
    ТопБлюд = ОтсортированныеДанныеАнализа("СуммарнаяСебестоимость УБЫВ", 6);

    Для Каждого СтрокаДанных Из ТопБлюд Цикл

        Точка = Отчет.ДиаграммаКруговая.УстановитьТочку(СтрокаДанных.ГотовоеБлюдо);
        Точка.УстановитьЗначение(СерияЗатраты, СтрокаДанных.СуммарнаяСебестоимость);

        // Устанавливаем цвет сектора
        Если ИндексЦвета < МассивЦветов.Количество() Тогда
            Точка.Цвет = МассивЦветов[ИндексЦвета];
            ИндексЦвета = ИндексЦвета + 1;
        КонецЕсли;

    КонецЦикла;

КонецПроцедуры

&НаКлиенте
Процедура СоздатьДиаграммуГистограммуПорций()

    // Создаем гистограмму для анализа количества приготовленных порций
    Отчет.ДиаграммаПорции.Очистить();
    Отчет.ДиаграммаПорции.ТипДиаграммы = ТипДиаграммы.ГистограммаОбъемная;
    Отчет.ДиаграммаПорции.Заголовок = "Количество приготовленных порций по блюдам";

    // Настраиваем оси
    Отчет.ДиаграммаПорции.ОсьX.Заголовок = "Блюда";
    Отчет.ДиаграммаПорции.ОсьY.Заголовок = "Количество порций";

    // Добавляем серию
    СерияПорции = Отчет.ДиаграммаПорции.УстановитьСерию("Порции");
    СерияПорции.Цвет = WebЦвета.ЗеленыйЛесной;

    // Заполняем данными
    Для Каждого СтрокаДанных Из Отчет.РезультатАнализа Цикл

        Точка = Отчет.ДиаграммаПорции.УстановитьТочку(Строка(СтрокаДанных.ГотовоеБлюдо));
        Точка.УстановитьЗначение(СерияПорции, СтрокаДанных.КоличествоПорций);

    КонецЦикла;

КонецПроцедуры

&НаКлиенте
Процедура СоздатьДиаграммуТрендаСебестоимости()

    // Создаем график для анализа эффективности (соотношение себестоимости и количества ингредиентов)
    Отчет.ДиаграммаТренд.Очистить();
    Отчет.ДиаграммаТренд.ТипДиаграммы = ТипДиаграммы.График;
    Отчет.ДиаграммаТренд.Заголовок = "Анализ эффективности: себестоимость vs сложность рецепта";

    // Настраиваем оси
    Отчет.ДиаграммаТренд.ОсьX.Заголовок = "Количество ингредиентов";
    Отчет.ДиаграммаТренд.ОсьY.Заголовок = "Себестоимость порции (грн)";

    // Добавляем серию
    СерияЭффективность = Отчет.ДиаграммаТренд.УстановитьСерию("Себестоимость/Сложность");
    СерияЭффективность.Цвет = WebЦвета.КрасныйТемный;
    СерияЭффективность.ТипЛинии = ТипЛинииДиаграммы.Сплошная;
    СерияЭффективность.ТипМаркера = ТипМаркераДиаграммы.Круг;

    // Сортируем по количеству ингредиентов (сортировка выполняется на сервере)
    ДанныеТренда = ОтсортированныеДанныеАнализа("КоличествоИнгредиентов ВОЗР");

    // Заполняем данными
    Для Каждого СтрокаДанных Из ДанныеТренда Цикл

        Точка = Отчет.ДиаграммаТренд.УстановитьТочку(СтрокаДанных.КоличествоИнгредиентов);
        Точка.УстановитьЗначение(СерияЭффективность, СтрокаДанных.СебестоимостьПорции);
        Точка.Текст = СтрокаДанных.ГотовоеБлюдо;

    КонецЦикла;

КонецПроцедуры

&НаКлиенте
Процедура РезультатАнализаВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)

    СтандартнаяОбработка = Ложь;

    ТекущиеДанные = Элементы.РезультатАнализа.ТекущиеДанные;
    Если ТекущиеДанные = Неопределено Тогда
        Возврат;
    КонецЕсли;

    // Открываем детализацию по ингредиентам
    ПоказатьДетализациюПоИнгредиентам(ТекущиеДанные.Рецепт);

КонецПроцедуры

&НаКлиенте
Процедура ПоказатьДетализациюПоИнгредиентам(Рецепт)

    Если НЕ ЗначениеЗаполнено(Рецепт) Тогда
        // Блюдо готовили без кулинарного рецепта — расшифровывать нечего
        Возврат;
    КонецЕсли;

    ПараметрыФормы = Новый Структура;
    ПараметрыФормы.Вставить("Рецепт", Рецепт);
    ПараметрыФормы.Вставить("НачалоПериода", Отчет.НачалоПериода);
    ПараметрыФормы.Вставить("КонецПериода", Отчет.КонецПериода);
    ПараметрыФормы.Вставить("Склад", Отчет.Склад);

    ОткрытьФорму("Обработка.АнализСебестоимостиБлюд.Форма.ДетализацияПоИнгредиентам", ПараметрыФормы);

КонецПроцедуры

#КонецОбласти

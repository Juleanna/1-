////////////////////////////////////////////////////////////////////////////////
// МОДУЛЬ ФОРМЫ ОБРАБОТКИ «ОБНОВЛЕНИЕ ЦЕН В ТЕХКАРТОЧКАХ»
//
// В выгрузке у обработки формы нет вообще: <DefaultForm/>, папки Forms
// не существует. Запустить обработку можно было только программно.
// Этот модуль вставляется в созданную форму — порядок создания формы
// описан в шаге 4.1 инструкции ОНОВЛЕННЯ.md.
//
// Что должно быть на форме:
//   * поля     Объект.РежимОбновления, Объект.ВыбранныйИнгредиент,
//              Объект.КоличествоОбновленных, Объект.КоличествоОшибок
//   * таблица  Объект.РезультатОбработки
//   * команда  ВыполнитьОбновление
//
// Привязки, без которых часть модуля молчит (см. шаг 2.5):
//   * форма → событие ПриОткрытии → ПриОткрытии
//   * поле «Режим обновления» → событие ПриИзменении → РежимОбновленияПриИзменении
//   * команда ВыполнитьОбновление → свойство «Действие» → ВыполнитьОбновление
//
// Поле Объект.ВыбраннаяКатегория необязательно: пока одноимённого реквизита
// у обработки нет, режим «По категории» недоступен, а модуль работает
// без изменений — элементы ищутся через Элементы.Найти.
////////////////////////////////////////////////////////////////////////////////

#Область ОбработчикиСобытийФормы

&НаКлиенте
Процедура ПриОткрытии(Отказ)

	УправлениеВидимостью();

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура РежимОбновленияПриИзменении(Элемент)

	УправлениеВидимостью();

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ВыполнитьОбновление(Команда)

	ОчиститьСообщения();
	ВыполнитьОбновлениеНаСервере();

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура ВыполнитьОбновлениеНаСервере()

	// РеквизитФормыВЗначение возвращает объект обработки со всеми
	// заполненными на форме реквизитами
	ОбработкаОбъект = РеквизитФормыВЗначение("Объект");

	ОбработкаОбъект.ВыполнитьОбновлениеЦен();

	// Обратное преобразование возвращает на форму результат: заполненную
	// табличную часть и счётчики. Без него обработка отработает,
	// но форма об этом не узнает — таблица останется пустой.
	ЗначениеВРеквизитФормы(ОбработкаОбъект, "Объект");

КонецПроцедуры

// Показывает только то поле, которое нужно выбранному режиму.
//
// Поля ВыбранныйИнгредиент и ВыбраннаяКатегория осмысленны не во всех
// режимах, а видимое, но неиспользуемое поле читается как «забыли заполнить».
&НаКлиенте
Процедура УправлениеВидимостью()

	УстановитьВидимостьПоля("ВыбранныйИнгредиент",
		ПредопределенноеЗначение("Перечисление.РежимыОбновленияЦен.ПоИнгредиенту"));

	УстановитьВидимостьПоля("ВыбраннаяКатегория",
		ПредопределенноеЗначение("Перечисление.РежимыОбновленияЦен.ПоКатегории"));

КонецПроцедуры

// Элемент ищется через Элементы.Найти, а не по имени напрямую: обращение
// Элементы.ВыбраннаяКатегория к несуществующему полю падает в момент
// выполнения, и форма переставала открываться, пока реквизит категории
// не создан.
&НаКлиенте
Процедура УстановитьВидимостьПоля(ИмяЭлемента, РежимДляПоля)

	Элемент = Элементы.Найти(ИмяЭлемента);

	Если Элемент = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Элемент.Видимость = (Объект.РежимОбновления = РежимДляПоля);

КонецПроцедуры

#КонецОбласти
